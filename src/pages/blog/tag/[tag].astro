---
import { getCollection } from 'astro:content';
import LandingPage from '../../../layouts/LandingPage.astro';

export async function getStaticPaths() {
    const allPosts = await getCollection('blog', ({ data }) => {
        return import.meta.env.PROD ? !data.draft : true;
    });

    // Collect all unique tags
    const tagMap = new Map<string, typeof allPosts>();

    allPosts.forEach(post => {
        (post.data.tags || []).forEach((tag: string) => {
            const slug = tag.toLowerCase().replace(/\s+/g, '-');
            if (!tagMap.has(slug)) {
                tagMap.set(slug, []);
            }
            tagMap.get(slug)!.push(post);
        });
    });

    return Array.from(tagMap.entries()).map(([tag, posts]) => ({
        params: { tag },
        props: {
            posts: posts.sort((a, b) =>
                new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
            ),
            tagName: posts[0].data.tags?.find(
                (t: string) => t.toLowerCase().replace(/\s+/g, '-') === tag
            ) || tag,
        },
    }));
}

const { tag } = Astro.params;
const { posts, tagName } = Astro.props;

const formatDate = (date: Date) => {
    return new Intl.DateTimeFormat('ro-RO', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    }).format(date);
};

const getReadingTime = (body: string) => {
    const wordCount = body.split(/\s+/).length;
    return Math.ceil(wordCount / 200);
};

const formatCategory = (category: string) => {
    const labels: Record<string, string> = {
        'chatbot-ai': 'Chatbot AI',
        'outreach': 'Outreach',
        'market-command': 'Market Command',
        'platforme': 'Platforme',
        'seo': 'SEO',
        'lead-generation': 'Lead Generation',
        'b2b-sales': 'B2B Sales',
        'marketing': 'Marketing',
        'ai': 'AI',
        'email-outreach': 'Email Outreach',
        'case-study': 'Case Study',
        'tutorial': 'Tutorial',
        'pharma': 'Pharma',
    };
    return labels[category] || category.split('-').map(word =>
        word.charAt(0).toUpperCase() + word.slice(1)
    ).join(' ');
};
---

<LandingPage
    title={`#${tagName} — Blog | WebSEM`}
    description={`Articole despre ${tagName}. Strategii și analize de la WebSEM.`}
>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <div class="breadcrumbs-container">
            <ol>
                <li><a href="/">Acasă</a></li>
                <li><a href="/blog">Blog</a></li>
                <li aria-current="page">#{tagName}</li>
            </ol>
        </div>
    </nav>

    <section class="tag-hero">
        <div class="tag-hero-content">
            <span class="tag-badge">#{tagName}</span>
            <h1>{posts.length} {posts.length === 1 ? 'articol' : 'articole'}</h1>
            <p>Toate articolele cu tag-ul <strong>#{tagName}</strong></p>
            <a href="/blog" class="tag-back">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Înapoi la Blog
            </a>
        </div>
    </section>

    <section class="tag-posts-section">
        <div class="tag-posts-container">
            <div class="tag-posts-grid">
                {posts.map(post => (
                    <article class="tag-post-card">
                        <a href={`/blog/${post.slug}`} class="tag-post-image">
                            {post.data.heroImage ? (
                                <img src={post.data.heroImage} alt={post.data.heroImageAlt || post.data.title} loading="lazy" />
                            ) : (
                                <div class="tag-placeholder">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path d="M19 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2z"/>
                                        <circle cx="8.5" cy="8.5" r="1.5"/>
                                        <path d="M21 15l-5-5L5 21"/>
                                    </svg>
                                </div>
                            )}
                        </a>
                        <div class="tag-post-content">
                            <div class="tag-post-meta">
                                <a href={`/blog`} class="tag-post-category">
                                    {formatCategory(post.data.category)}
                                </a>
                                <span class="tag-meta-sep">·</span>
                                <span class="tag-post-time">{post.data.readingTime || getReadingTime(post.body || '')} min citire</span>
                            </div>
                            <h3><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
                            <p>{post.data.description}</p>
                            <div class="tag-post-footer">
                                <span class="tag-post-date">{formatDate(post.data.pubDate)}</span>
                                <a href={`/blog/${post.slug}`} class="tag-read-link">
                                    Citește
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                </a>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>
</LandingPage>

<style>
    .breadcrumbs {
        padding: 7rem 2rem 0;
    }

    .breadcrumbs-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .breadcrumbs ol {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.85rem;
    }

    .breadcrumbs li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
    }

    .breadcrumbs li:not(:last-child)::after {
        content: '/';
        color: var(--text-muted);
    }

    .breadcrumbs a {
        color: var(--text-tertiary);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .breadcrumbs a:hover {
        color: var(--accent-light);
    }

    .tag-hero {
        padding: 3rem 2rem 4rem;
        text-align: center;
    }

    .tag-hero-content {
        max-width: 600px;
        margin: 0 auto;
    }

    .tag-badge {
        display: inline-block;
        padding: 0.5rem 1.25rem;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(118, 75, 162, 0.1));
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--accent-light);
        margin-bottom: 1.5rem;
        letter-spacing: 0.02em;
    }

    .tag-hero h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        margin-bottom: 0.75rem;
        color: var(--text-primary);
    }

    .tag-hero p {
        font-size: 1.05rem;
        color: var(--text-tertiary);
        margin-bottom: 2rem;
    }

    .tag-hero p strong {
        color: var(--text-secondary);
    }

    .tag-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        transition: color 0.2s ease;
    }

    .tag-back:hover {
        color: var(--accent-light);
    }

    .tag-posts-section {
        padding: 0 2rem 5rem;
    }

    .tag-posts-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .tag-posts-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .tag-post-card {
        background: var(--bg-card);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .tag-post-card:hover {
        border-color: var(--border-accent);
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }

    .tag-post-image {
        display: block;
        aspect-ratio: 16/10;
        overflow: hidden;
        background: var(--bg-input);
    }

    .tag-post-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .tag-post-card:hover .tag-post-image img {
        transform: scale(1.05);
    }

    .tag-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-input);
    }

    .tag-placeholder svg {
        width: 48px;
        height: 48px;
        color: var(--text-muted);
    }

    .tag-post-content {
        padding: 1.25rem;
    }

    .tag-post-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .tag-post-category {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--accent-light);
        background: var(--bg-input);
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        text-decoration: none;
        transition: background 0.2s ease;
    }

    .tag-post-category:hover {
        background: var(--bg-input-focus);
    }

    .tag-meta-sep {
        color: var(--text-muted);
        font-size: 0.7rem;
    }

    .tag-post-time {
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    .tag-post-content h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        line-height: 1.35;
    }

    .tag-post-content h3 a {
        color: var(--text-primary);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .tag-post-content h3 a:hover {
        color: var(--accent-light);
    }

    .tag-post-content p {
        font-size: 0.82rem;
        color: var(--text-tertiary);
        line-height: 1.5;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .tag-post-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-light);
    }

    .tag-post-date {
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    .tag-read-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--accent-light);
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .tag-read-link:hover {
        color: var(--accent);
    }

    .tag-read-link:hover svg {
        transform: translateX(3px);
    }

    .tag-read-link svg {
        transition: transform 0.2s ease;
    }

    @media (max-width: 900px) {
        .tag-posts-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .breadcrumbs {
            padding-top: 6rem;
        }

        .tag-posts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
