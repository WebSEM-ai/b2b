---
import LandingPage from '../../layouts/LandingPage.astro';
import ShowcaseHero from '../../components/platforme/ShowcaseHero.astro';
import ProjectInfo from '../../components/platforme/ProjectInfo.astro';
import ScreenshotGallery from '../../components/platforme/ScreenshotGallery.astro';
import TechStack from '../../components/platforme/TechStack.astro';
import ProjectResults from '../../components/platforme/ProjectResults.astro';
import CtaSection from '../../components/CtaSection.astro';
import BookingModal from '../../components/BookingModal.astro';

const pageTitle = "E-Commerce Modern — RV Tourism / Autorulote | WebSEM Platforme";
const pageDescription = "Case study: platformă e-commerce modernă pentru RV Tourism — marketplace autorulote, campinguri și dealeri. Arhitectură modulară, PageSpeed 95+, zero dependență Shopify.";
---

<LandingPage
    title={pageTitle}
    description={pageDescription}
    footerCtaBadge="WebSEM Platforme"
    footerCtaTitle='Vrei un magazin online <span class="gradient-text">fără limitări</span>?'
    footerCtaSubtitle='Construim magazine online moderne cu <strong>arhitectură modulară</strong> și <strong>costuri reduse cu 70–90%</strong> față de Shopify. Solicită o consultație gratuită.'
    footerCtaStats={[
        { value: '95+', label: 'PageSpeed' },
        { value: '~€0', label: 'Costuri Lunare' },
        { value: '8 săpt.', label: 'Livrare' }
    ]}
    footerCtaButtonText="Solicită Consultație"
    footerCtaDisclaimer="* Discuție inițială gratuită. Analizăm cerințele și pregătim o propunere personalizată."
>
    <div class="ec-page">
        <!-- S1: Showcase Hero -->
        <ShowcaseHero
            badge="E-COMMERCE MODERN — CASE STUDY"
            title='RV Tourism <strong>Autorulote</strong>'
            subtitle="Marketplace complet pentru autorulote, campinguri și dealeri din România — hartă interactivă, catalog cu filtrare avansată, costuri de operare ~€0/lună."
            heroImage="/images/platforme/autorulote/Platforme-Moderne2.webp"
            heroImageAlt="RV Tourism — Homepage Hero"
            browserUrl="rvtourism.ro"
            ctaSecondaryText="Vezi Galeria"
            ctaSecondaryHref="#galerie"
            stats={[
                { value: '95+', label: 'PageSpeed' },
                { value: '~€0', label: 'Cost Lunar' },
                { value: '27+', label: 'Locații' },
                { value: '<1s', label: 'Load Time' }
            ]}
        />

        <!-- S2: Tech Stack -->
        <TechStack
            title="Tehnologii Utilizate"
            subtitle="Arhitectură modulară care bate Shopify la toate capitolele"
            technologies={[
                {
                    name: 'Next.js',
                    description: 'React Framework',
                    icon: `<svg viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg"><circle cx="128" cy="128" r="126" fill="none" stroke="currentColor" stroke-width="8"/><path d="M109 63v130l80-110" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/></svg>`
                },
                {
                    name: 'Payload CMS',
                    description: 'Admin & Content',
                    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg"><path d="M4 6h16M4 12h16M4 18h8"/><rect x="14" y="15" width="6" height="6" rx="1"/></svg>`
                },
                {
                    name: 'Neon DB',
                    description: 'PostgreSQL Serverless',
                    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.657 3.582 3 8 3s8-1.343 8-3V6"/><path d="M4 12v6c0 1.657 3.582 3 8 3s8-1.343 8-3v-6"/></svg>`
                },
                {
                    name: 'Cloudflare R2',
                    description: 'CDN & Imagini',
                    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg"><path d="M17.5 19H9.5a7 7 0 1 1 4.566-12.318A5 5 0 0 1 22 11a5 5 0 0 1-4.5 8Z"/></svg>`
                },
                {
                    name: 'Vercel',
                    description: 'Edge Deployment',
                    icon: `<svg viewBox="0 0 256 222" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid"><path fill="currentColor" d="m128 0 128 221.705H0z"/></svg>`
                }
            ]}
        />

        <!-- S3: Project Info -->
        <ProjectInfo
            description={`<p>RV Tourism este prima platformă completă din România dedicată comunității de autorulote — un marketplace care reunește închirieri, dealeri autorizați, service-uri, campinguri și evenimente, totul într-un singur loc.</p>
            <p>Am construit o arhitectură modernă, modulară, care înlocuiește dependența de Shopify cu un stack performant: Next.js pentru frontend ultra-rapid, Payload CMS pentru administrare simplă, Neon DB pentru date fiabile și Cloudflare R2 pentru imagini livrate instant din 300+ locații globale.</p>
            <p>Rezultatul: un site cu <strong>PageSpeed 95+</strong>, costuri operaționale de <strong>~€0/lună</strong> (free tier) și independență totală față de orice platformă terță. Datele sunt 100% ale clientului.</p>`}
            client="RV Tourism / Autorulote"
            projectType="Marketplace E-Commerce"
            timeline="8 săptămâni"
            features={[
                'Hartă interactivă cu 27+ locații',
                'Catalog închirieri cu filtre avansate',
                'Marketplace campinguri cu prețuri',
                'Director dealeri autorizați',
                'Calendar evenimente & târguri',
                'Oferte premium cu cards interactive',
                'Filtrare rapidă pe categorii',
                'Design responsive premium'
            ]}
        />

        <!-- S4: Screenshot Gallery -->
        <ScreenshotGallery
            title="Galeria Proiectului"
            subtitle="Explorează fiecare secțiune a platformei"
            screenshots={[
                { src: '/images/platforme/autorulote/Platforme-Moderne2.webp', alt: 'Homepage hero', caption: 'Homepage Hero — „Drumul tău. Regulile tale." cu search bar și categorii rapide' },
                { src: '/images/platforme/autorulote/Platforme-Moderne3.webp', alt: 'Oferte premium', caption: 'Oferte Premium — Cards interactive cu prețuri per zi și detalii vehicule' },
                { src: '/images/platforme/autorulote/Platforme-Moderne4.webp', alt: 'Hartă interactivă', caption: 'Hartă Interactivă — Toate locațiile din România cu filtrare pe categorii' },
                { src: '/images/platforme/autorulote/Platforme-Moderne1.webp', alt: 'Hartă cu filtre', caption: 'Filtrare Rapidă — Închirieri, Dealeri, Conversii, Service, Campinguri pe hartă' },
                { src: '/images/platforme/autorulote/Platforme-Moderne6.webp', alt: 'Catalog închirieri', caption: 'Catalog Închirieri — Filtre avansate: tip, preț, paturi, transmisie, combustibil' },
                { src: '/images/platforme/autorulote/Platforme-Moderne7.webp', alt: 'Catalog autorulote', caption: 'Rezultate Catalog — Cards cu prețuri, rating-uri și specificații detaliate' },
                { src: '/images/platforme/autorulote/Platforme-Moderne8.webp', alt: 'Campinguri', caption: 'Campinguri — Grid cu prețuri per noapte, rating-uri și facilități disponibile' },
                { src: '/images/platforme/autorulote/Platforme-Moderne9.webp', alt: 'Dealeri autorizați', caption: 'Dealeri Autorizați — XGO, Elnagh, Panama Van, Campero cu branduri și rating-uri' },
                { src: '/images/platforme/autorulote/Platforme-Moderne10.webp', alt: 'Evenimente 2026', caption: 'Evenimente 2026 — Calendar interactiv cu târguri, festivaluri și întâlniri' },
                { src: '/images/platforme/autorulote/Platforme-Moderne5.webp', alt: 'Hartă mobilă', caption: 'Responsive Mobile — Hartă interactivă optimizată pentru dispozitive mobile' }
            ]}
        />

        <!-- S5: Project Results -->
        <ProjectResults
            title="Rezultate & Performanță"
            stats={[
                { value: '95+', label: 'PageSpeed Score' },
                { value: '~€0', label: 'Cost Lunar' },
                { value: '<1s', label: 'Load Time' },
                { value: '70-90%', label: 'Economie vs Shopify' }
            ]}
            highlights={[
                {
                    title: 'Zero dependență Shopify',
                    description: 'Arhitectură open-source, fără abonamente lunare fixe, fără comisioane pe tranzacție (doar Stripe ~1.4%), fără vendor lock-in.',
                    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
                },
                {
                    title: 'Marketplace complet',
                    description: 'Închirieri, dealeri, campinguri, service și evenimente — totul într-o singură platformă cu hartă interactivă și filtrare inteligentă.',
                    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
                },
                {
                    title: 'Costuri reduse 70–90%',
                    description: 'Free tier-urile serviciilor acoperă nevoile unui magazin cu catalog redus. Crești costurile doar când crește afacerea.',
                    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>`
                },
                {
                    title: 'Date 100% ale clientului',
                    description: 'Baza de date PostgreSQL, imagini pe Cloudflare R2, cod open-source. Migrarea de pe Shopify a fost completă și ireversibilă.',
                    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`
                }
            ]}
        />

        <!-- S6: CTA -->
        <CtaSection
            title="Vrei un magazin online fără limitări?"
            subtitle="Construim magazine online moderne cu arhitectură modulară, performanță de top și costuri reduse. Solicită o consultație gratuită."
            buttonText="Solicită Consultație"
            note="Fără obligații. Discuție inițială gratuită."
        />
    </div>

    <!-- Booking Modal -->
    <BookingModal
        title="Solicită Consultație E-Commerce"
        subtitle="Completează formularul și te contactăm în 24h pentru a discuta proiectul tău"
    />
</LandingPage>

<style is:global>
    /* E-Commerce Modern scoped color palette — Emerald/Green */
    .ec-page {
        --sp-primary: #10B981;
        --sp-primary-light: #34D399;
        --sp-secondary: #059669;
        --sp-primary-glow: rgba(16, 185, 129, 0.3);
        --sp-gradient: linear-gradient(135deg, #10B981, #059669);
    }

    [data-theme="light"] .ec-page {
        --sp-primary-glow: rgba(16, 185, 129, 0.15);
    }

    /* ShowcaseHero overrides */
    .ec-page .showcase-hero-badge {
        border-color: rgba(16, 185, 129, 0.3);
        background: rgba(16, 185, 129, 0.08);
    }

    .ec-page .showcase-hero-title strong {
        background: linear-gradient(135deg, #10B981, #059669) !important;
        -webkit-background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
    }

    .ec-page .showcase-btn--primary {
        background: linear-gradient(135deg, #10B981, #059669) !important;
    }

    .ec-page .showcase-btn--primary:hover {
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3) !important;
    }

    .ec-page .showcase-btn--secondary:hover {
        border-color: rgba(16, 185, 129, 0.4) !important;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.1) !important;
    }

    .ec-page .showcase-stat-value {
        background: linear-gradient(135deg, #10B981, #059669) !important;
        -webkit-background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
    }

    .ec-page .orb-1 {
        background: radial-gradient(circle, rgba(16, 185, 129, 0.25), transparent 70%) !important;
    }

    .ec-page .orb-2 {
        background: radial-gradient(circle, rgba(5, 150, 105, 0.2), transparent 70%) !important;
    }

    /* Override CTA section for emerald theme */
    .ec-page .cta-btn {
        background: linear-gradient(135deg, #10B981, #059669);
    }

    .ec-page .cta-btn:hover {
        box-shadow: 0 0 30px rgba(16, 185, 129, 0.4);
    }

    /* Override booking modal submit for emerald theme */
    .ec-page ~ .booking-modal .modal-form-submit {
        background: linear-gradient(135deg, #10B981, #059669);
    }

    .ec-page ~ .booking-modal .modal-form-submit:hover {
        box-shadow: 0 0 30px rgba(16, 185, 129, 0.4);
    }

    .ec-page ~ .booking-modal .modal-input-wrapper input:focus {
        border-color: rgba(16, 185, 129, 0.5);
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);
    }

    /* ProjectInfo feature checkmarks */
    .ec-page .info-feature-item svg {
        color: #10B981;
    }

    .ec-page .info-card-link {
        background: linear-gradient(135deg, #10B981, #059669);
    }

    .ec-page .info-card-link:hover {
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);
    }

    /* Gallery caption border */
    .ec-page .gallery-item-caption {
        border-left-color: rgba(16, 185, 129, 0.4);
    }

    .ec-page .browser-frame:hover,
    .ec-page .browser-frame-hero:hover {
        border-color: rgba(16, 185, 129, 0.3);
    }

    /* TechStack card hover */
    .ec-page .tech-card:hover {
        border-color: rgba(16, 185, 129, 0.25);
        box-shadow: 0 8px 30px rgba(16, 185, 129, 0.1);
    }

    .ec-page .tech-card:hover .tech-card-icon {
        color: #10B981;
    }

    /* ProjectResults gradient stats */
    .ec-page .results-stat-value {
        background: linear-gradient(135deg, #10B981, #059669);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .ec-page .highlight-card:hover {
        border-color: rgba(16, 185, 129, 0.25);
        box-shadow: 0 8px 30px rgba(16, 185, 129, 0.1);
    }

    .ec-page .highlight-card-icon {
        color: #10B981;
    }
</style>
