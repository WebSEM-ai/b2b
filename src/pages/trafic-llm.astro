---
import LandingPage from '../layouts/LandingPage.astro';
import Hero from '../components/Hero.astro';
import ClientsCarousel from '../components/ClientsCarousel.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import TabSection from '../components/TabSection.astro';
import LLMOptimizations from '../components/llm/LLMOptimizations.astro';
import LLMDeliverables from '../components/llm/LLMDeliverables.astro';
import PricingSection from '../components/PricingSection.astro';
import CtaSection from '../components/CtaSection.astro';
import BookingModal from '../components/BookingModal.astro';

const pageTitle = "Trafic LLM — Fii Recomandat de AI | AlphaGrade by WebSEM";
const pageDescription = "ChatGPT si Gemini recomanda branduri de milioane de ori pe zi. Optimizam prezenta ta digitala ca sa fii in acele recomandari. Analiza gratuita in 24h.";

const ORG_ID = 'https://websem.ro/#organization';
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://b2b.websem.ro').toString();

// FAQ — text identic cu secțiunea vizibilă de mai jos (cerință pentru FAQPage schema)
const faqs = [
    {
        q: 'Ce este AEO (Answer Engine Optimization)?',
        a: 'AEO este optimizarea conținutului ca să fie extras și citat direct de motoarele AI (ChatGPT, Google AI Overviews, Gemini, Perplexity). Spre deosebire de SEO clasic, unde concurezi pentru poziții în Google, la AEO obiectivul este ca AI-ul să te recomande ca sursă în răspunsul generat.',
    },
    {
        q: 'Care este diferența dintre SEO și GEO / AEO?',
        a: 'SEO te aduce pe prima pagină în Google. GEO (Generative Engine Optimization) și AEO te fac citat în răspunsurile generate de AI. O pagină bine structurată poate fi recomandată de ChatGPT chiar dacă în Google e pe pagina 2-3, pentru că AI-ul alege sursele după claritate, structură și autoritate, nu doar după poziție.',
    },
    {
        q: 'În cât timp apar în răspunsurile ChatGPT, Gemini sau Perplexity?',
        a: 'Primele semnale apar de obicei în 4-8 săptămâni de la implementare, după ce motoarele AI re-crawlează și re-indexează conținutul optimizat. Perplexity și Google AI Overviews reacționează mai rapid, ChatGPT mai lent. Rezultatele consistente se consolidează în 3-6 luni de optimizare continuă.',
    },
    {
        q: 'Cum măsurați vizibilitatea în AI?',
        a: 'Rulăm întrebările relevante pentru business-ul tău în 5 motoare AI și înregistrăm dacă apari, cine mai apare (competiția) și ce pagină e citată. Din asta rezultă un benchmark competitiv și un scor de share-of-AI-voice, monitorizat lunar în raportul de progres.',
    },
    {
        q: 'Cât costă optimizarea pentru vizibilitate în AI?',
        a: 'Pachetele pornesc de la €800/lună (SIGNAL — benchmark și primele optimizări), €1.800/lună (PRESENCE — strategie completă) și €3.500/lună (DOMINANCE — conținut nelimitat și monitorizare săptămânală). Analiza inițială de vizibilitate AI este gratuită și se livrează în 24h.',
    },
];

const serviceSchema = {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    name: 'Trafic LLM — Optimizare AEO / GEO pentru vizibilitate în AI',
    serviceType: 'Answer Engine Optimization / Generative Engine Optimization',
    description: pageDescription,
    url: pageUrl,
    provider: { '@id': ORG_ID },
    areaServed: { '@type': 'Country', name: 'România' },
    offers: [
        { '@type': 'Offer', name: 'SIGNAL', price: '800', priceCurrency: 'EUR', url: pageUrl, description: 'Benchmark + primele optimizări. 3 pagini optimizate/lună.' },
        { '@type': 'Offer', name: 'PRESENCE', price: '1800', priceCurrency: 'EUR', url: pageUrl, description: 'Strategie completă AI-first. 8 pagini optimizate/lună.' },
        { '@type': 'Offer', name: 'DOMINANCE', price: '3500', priceCurrency: 'EUR', url: pageUrl, description: 'Conținut nelimitat + monitorizare săptămânală.' },
    ],
};

const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
};

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Acasă', item: 'https://b2b.websem.ro/' },
        { '@type': 'ListItem', position: 2, name: 'Trafic LLM (AEO / GEO)', item: pageUrl },
    ],
};
---

<LandingPage
    title={pageTitle}
    description={pageDescription}
    footerCtaBadge="Trafic LLM"
    footerCtaTitle='Ești în răspunsurile AI <span class="gradient-text">ale competiției tale</span>?'
    footerCtaSubtitle='Solicită o <strong>analiză gratuită</strong> și îți arătăm în 24h exact unde apari tu — și unde apare competiția ta — în ChatGPT, Gemini și Perplexity.'
    footerCtaStats={[
        { value: '5', label: 'AI-uri Analizate' },
        { value: '24h', label: 'Livrare' },
        { value: 'Gratuit', label: 'Analiza Inițială' }
    ]}
    footerCtaButtonText="Solicită Analiză Gratuită"
    footerCtaDisclaimer="* Analizăm prezența ta în principalele AI-uri și îți livrăm un sumar acționabil gratuit."
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    </Fragment>
    <div class="llm-page">
        <!-- S1: Hero -->
        <Hero
            badge="LLM TRAFFIC — OPTIMIZARE AI"
            titleLine1='<strong>AI-ul</strong> te recomandă?'
            titleLine2="Dacă nu, competiția ta e deja acolo."
            subtitle="ChatGPT, Gemini și Perplexity recomandă branduri de milioane de ori pe zi. Optimizăm prezența ta digitală ca să fii în acele recomandări — înainte ca fereastra să se închidă."
            floatingStats={[
                { value: '3.2B', label: 'Întrebări/Zi în AI' },
                { value: '40%', label: 'Research B2B prin AI' },
                { value: '<3%', label: 'Au Început în RO' }
            ]}
            formTitle="Solicită Analiză Gratuită"
            formSubtitle="Analizăm vizibilitatea ta în AI în 24h"
        />

        <!-- S2: Clients Carousel -->
        <ClientsCarousel />

        <!-- S3: Benefits — De ce acum -->
        <BenefitsSection
            title="De ce contează azi, nu peste 2 ani."
            subtitle="Nu e un trend. E o schimbare structurală în cum cumpără B2B."
            benefits={[
                {
                    title: 'Schimbarea Canalului',
                    description: '40% din research-ul B2B se face acum prin AI, nu prin Google. Procentul crește cu 3-5% lunar.',
                    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>`,
                    stat: { icon: '↑', text: '40% B2B' }
                },
                {
                    title: 'Fereastra First-Mover',
                    description: 'Pozițiile în răspunsurile AI nu se cumpără. Se câștigă prin relevanță și consistență. Primii care intră, rămân.',
                    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
                    stat: { icon: '✓', text: 'Early-Adopter RO' }
                },
                {
                    title: 'Costul Așteptării',
                    description: 'Companiile care intră în LLM optimization în 2025 plătesc de 8-10x mai puțin decât vor plăti în 2027 pentru același rezultat.',
                    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
                    stat: { icon: '✓', text: '8x Mai Ieftin Acum' }
                },
                {
                    title: 'Zero Competiție Locală',
                    description: 'În România, sub 3% din companii au o strategie activă de LLM visibility. Piața e deschisă.',
                    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
                    stat: { icon: '✓', text: '<3% Au Început' }
                }
            ]}
        />

        <!-- S4: TabSection — Ce Optimizam + Ce Primesti -->
        <TabSection tabs={["Ce Optimizăm", "Ce Primești"]} id="llm-scope">
            <div data-tab-panel="0">
                <LLMOptimizations />
            </div>
            <div data-tab-panel="1">
                <LLMDeliverables />
            </div>
        </TabSection>

        <!-- S5: Pricing — SIGNAL / PRESENCE / DOMINANCE -->
        <PricingSection
            title="Pachete & Prețuri"
            subtitle="Vizibilitate AI la nivel enterprise. Investiție, nu cost."
            note="Toate pachetele includ: analiză inițială, benchmark competitiv și raportare lunară. Prețurile sunt orientative și pot fi ajustate în funcție de complexitate."
            tiers={[
                {
                    name: 'SIGNAL',
                    price: '€800',
                    priceNote: '/lună',
                    description: 'Intri pe radar. Benchmark + primele optimizări.',
                    featureGroups: [
                        {
                            label: 'Analiză & Conținut',
                            items: [
                                'Analiză vizibilitate LLM (5 AI-uri)',
                                'Raport competitiv inițial',
                                '3 pagini de conținut optimizat/lună',
                                'Raport lunar de monitorizare'
                            ]
                        }
                    ],
                    timeline: 'Livrare: 7-10 zile lucrătoare',
                    highlighted: false
                },
                {
                    name: 'PRESENCE',
                    price: '€1.800',
                    priceNote: '/lună',
                    description: 'Ești recomandat. Strategie completă + implementare continuă.',
                    featureGroups: [
                        {
                            label: 'Tot ce include SIGNAL, plus',
                            items: [
                                'Strategie completă de conținut AI-first',
                                '8 pagini optimizate/lună',
                                'Optimizare profil de autoritate (mențiuni, date structurate)',
                                'Sesiune lunară de review cu echipa ta (60 min)'
                            ]
                        }
                    ],
                    timeline: 'Livrare: 14 zile lucrătoare',
                    highlighted: true
                },
                {
                    name: 'DOMINANCE',
                    price: '€3.500',
                    priceNote: '/lună',
                    description: 'Controlezi narativul. Dominanță în toate AI-urile relevante.',
                    featureGroups: [
                        {
                            label: 'Tot ce include PRESENCE, plus',
                            items: [
                                'Conținut nelimitat',
                                'Monitorizare săptămânală',
                                'War room session trimestrial (workshop 2h cu echipa ta)',
                                'Priority support — acces direct la echipa de analiști'
                            ]
                        }
                    ],
                    timeline: 'Livrare: ongoing',
                    highlighted: false
                }
            ]}
        />

        <!-- S5.5: FAQ — optimizat pentru citare AI (AEO) -->
        <section class="llm-faq" id="faq" aria-labelledby="faq-title">
            <div class="llm-faq-inner">
                <div class="llm-faq-head">
                    <span class="llm-faq-badge">Întrebări frecvente</span>
                    <h2 id="faq-title">AEO, GEO și trafic din AI — pe scurt</h2>
                    <p>Răspunsuri directe la ce ne întreabă cel mai des companiile B2B despre vizibilitatea în ChatGPT, Gemini și Perplexity.</p>
                </div>
                <div class="llm-faq-list">
                    {faqs.map((f) => (
                        <details class="llm-faq-item">
                            <summary>{f.q}</summary>
                            <div class="llm-faq-answer"><p>{f.a}</p></div>
                        </details>
                    ))}
                </div>
                <p class="llm-faq-more">
                    Vrei definițiile complete? Vezi <a href="https://websem.ro/en/resources/atlas/glossary">Atlasul WebSEM — glosar AEO / GEO / LLMO</a>.
                </p>
            </div>
        </section>

        <!-- S6: CTA Final -->
        <CtaSection
            title="Ești în răspunsurile AI ale competiției tale?"
            subtitle="Solicită o analiză gratuită și îți arătăm în 24h exact unde apari tu — și unde apare competiția ta — în ChatGPT, Gemini și Perplexity."
            buttonText="Solicită Analiză Gratuită"
            note="Fără obligații. Primești răspuns în 24h."
        />
    </div>

    <!-- Booking Modal -->
    <BookingModal
        title="Solicită Analiză LLM Gratuită"
        subtitle="Completează formularul și analizăm vizibilitatea ta în AI în 24h"
    />
</LandingPage>

<style is:global>
    /* Trafic LLM scoped color palette — Electric Violet/Purple */
    .llm-page {
        --llm-primary: #8B5CF6;
        --llm-primary-light: #A78BFA;
        --llm-secondary: #D946EF;
        --llm-primary-glow: rgba(139, 92, 246, 0.3);
        --llm-gradient: linear-gradient(135deg, #8B5CF6, #D946EF);
    }

    [data-theme="light"] .llm-page {
        --llm-primary-glow: rgba(139, 92, 246, 0.15);
    }

    /* Override Hero floating stats for violet theme */
    .llm-page .hero .floating-stat-value {
        background: linear-gradient(135deg, #8B5CF6, #D946EF);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .llm-page .hero-label {
        border-color: rgba(139, 92, 246, 0.3);
        background: rgba(139, 92, 246, 0.08);
    }

    .llm-page .hero-title .gradient {
        background: linear-gradient(135deg, #8B5CF6, #D946EF);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Override tab active button for violet theme */
    .llm-page .tab-btn--active {
        background: linear-gradient(135deg, #8B5CF6, #D946EF);
        box-shadow: 0 4px 20px rgba(139, 92, 246, 0.4);
    }

    .llm-page .tab-btn--active .tab-btn-indicator {
        border-top-color: #D946EF;
    }

    .llm-page .tab-btn:hover:not(.tab-btn--active) {
        border-color: rgba(139, 92, 246, 0.2);
    }

    /* Override BenefitsSection stat icon for violet */
    .llm-page .benefit-card-stat-icon {
        background: rgba(139, 92, 246, 0.15);
        color: #8B5CF6;
    }

    .llm-page .benefit-card-visual-placeholder {
        border-color: rgba(139, 92, 246, 0.2);
        color: #8B5CF6;
    }

    .llm-page .benefit-card:hover {
        border-color: rgba(139, 92, 246, 0.25);
        box-shadow: 0 8px 30px rgba(139, 92, 246, 0.12);
    }

    /* Override pricing gradient for LLM violet theme */
    .llm-page .pricing-card--highlighted {
        border-color: rgba(139, 92, 246, 0.3);
        box-shadow: 0 0 30px rgba(139, 92, 246, 0.15);
    }

    .llm-page .pricing-card--highlighted:hover {
        box-shadow: 0 0 30px rgba(139, 92, 246, 0.25), var(--shadow-lg);
    }

    .llm-page .pricing-badge {
        background: linear-gradient(135deg, #8B5CF6, #D946EF);
    }

    .llm-page .pricing-price {
        background: linear-gradient(135deg, #8B5CF6, #D946EF);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .llm-page .pricing-card--highlighted .pricing-cta {
        background: linear-gradient(135deg, #8B5CF6, #7c3aed);
    }

    .llm-page .pricing-card--highlighted .pricing-cta:hover {
        box-shadow: 0 0 30px rgba(139, 92, 246, 0.4);
    }

    .llm-page .pricing-card:hover {
        border-color: rgba(139, 92, 246, 0.2);
    }

    .llm-page .pricing-cta:hover {
        border-color: rgba(139, 92, 246, 0.5);
        box-shadow: 0 0 20px rgba(139, 92, 246, 0.2);
    }

    .llm-page .feature-group-label {
        color: #8B5CF6;
    }

    .llm-page .pricing-features li svg {
        color: #8B5CF6;
    }

    /* Override CTA section for violet theme */
    .llm-page .cta-btn {
        background: linear-gradient(135deg, #8B5CF6, #D946EF);
    }

    .llm-page .cta-btn:hover {
        box-shadow: 0 0 30px rgba(139, 92, 246, 0.4);
    }

    /* Override audit form submit for violet theme */
    .llm-page .audit-form-submit {
        background: linear-gradient(135deg, #8B5CF6, #D946EF);
    }

    .llm-page .audit-form-submit:hover {
        box-shadow: 0 0 25px rgba(139, 92, 246, 0.4);
    }

    .llm-page .audit-form-field input:focus {
        border-color: rgba(139, 92, 246, 0.5);
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
    }

    /* FAQ Section (AEO) */
    .llm-faq {
        padding: 5rem 1.5rem;
    }
    .llm-faq-inner {
        max-width: 820px;
        margin: 0 auto;
    }
    .llm-faq-head {
        text-align: center;
        margin-bottom: 3rem;
    }
    .llm-faq-badge {
        display: inline-block;
        padding: 0.35rem 0.9rem;
        border-radius: 50px;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #A78BFA;
        border: 1px solid rgba(139, 92, 246, 0.3);
        background: rgba(139, 92, 246, 0.08);
        margin-bottom: 1.25rem;
    }
    .llm-faq-head h2 {
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        line-height: 1.2;
        margin-bottom: 0.75rem;
    }
    .llm-faq-head p {
        color: var(--gray-400);
        max-width: 620px;
        margin: 0 auto;
        line-height: 1.6;
    }
    .llm-faq-item {
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 14px;
        padding: 0.35rem 1.5rem;
        margin-bottom: 1rem;
        background: rgba(139, 92, 246, 0.03);
        transition: border-color 0.3s ease;
    }
    .llm-faq-item[open] {
        border-color: rgba(139, 92, 246, 0.4);
    }
    .llm-faq-item summary {
        cursor: pointer;
        list-style: none;
        padding: 1.15rem 0;
        font-size: 1.08rem;
        font-weight: 600;
        color: var(--white);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }
    .llm-faq-item summary::-webkit-details-marker {
        display: none;
    }
    .llm-faq-item summary::after {
        content: '+';
        font-size: 1.5rem;
        font-weight: 400;
        color: #A78BFA;
        transition: transform 0.3s ease;
        flex-shrink: 0;
    }
    .llm-faq-item[open] summary::after {
        transform: rotate(45deg);
    }
    .llm-faq-answer {
        padding: 0 0 1.25rem;
    }
    .llm-faq-answer p {
        color: var(--gray-400);
        line-height: 1.7;
        margin: 0;
    }
    .llm-faq-more {
        text-align: center;
        margin-top: 2rem;
        color: var(--gray-500);
        font-size: 0.95rem;
    }
    .llm-faq-more a {
        color: #A78BFA;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    [data-theme="light"] .llm-faq-item summary {
        color: var(--black, #0a0a0a);
    }
</style>
