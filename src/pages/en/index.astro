---
import LandingPage from '../../layouts/LandingPage.astro';
import Hero from '../../components/Hero.astro';
import ClientsCarousel from '../../components/ClientsCarousel.astro';
import BenefitsSection from '../../components/BenefitsSection.astro';
import StatsSection from '../../components/StatsSection.astro';
import VendorFailures from '../../components/VendorFailures.astro';
import FeaturesSection from '../../components/FeaturesSection.astro';
import CapabilitiesSection from '../../components/CapabilitiesSection.astro';
import TabSection from '../../components/TabSection.astro';
import PricingSection from '../../components/PricingSection.astro';
import CtaSection from '../../components/CtaSection.astro';
import BookingModal from '../../components/BookingModal.astro';

// Page metadata
const pageTitle = "AlphaGrade | B2B Pipeline Intelligence — Outbound That Actually Converts";
const pageDescription = "We build $250K+ B2B pipelines in 90 days. Hyper-targeted outbound to VP+ decision-makers at $10M+ companies. Apollo.io-powered. Done-for-you.";
---

<LandingPage
    title={pageTitle}
    description={pageDescription}
    lang="en"
    navLinks={[
        { text: 'Services', href: '#', children: [
            { text: 'Outreach', href: '/en' },
            { text: 'Market Command', href: '/market-command' },
            { text: 'Niche Domination', href: '/niche-domination/pharma', children: [
                { text: 'Pharma', href: '/niche-domination/pharma' }
            ]},
            { text: 'Platforms', href: '/platforme' },
            { text: 'AI Chatbot', href: '/chatbot-ai' }
        ]},
        { text: 'Blog', href: '/blog' },
        { text: 'Contact', href: '#contact' }
    ]}
    navCta={{ text: 'Book a Demo', href: '' }}
    navPoweredByText="a service by"
    langSwitch={{ current: 'en', alternateUrl: '/' }}
    footerCtaBadge="Get Started"
    footerCtaTitle='Ready to <span class="gradient-text">Supercharge</span> Your B2B Pipeline?'
    footerCtaSubtitle='First 10 clients this month get a <strong>free pipeline audit</strong> and <strong>50 bonus leads</strong>.'
    footerCtaStats={[
        { value: '265M+', label: 'Verified Contacts' },
        { value: '98%', label: 'Email Accuracy' },
        { value: '72h', label: 'Full Deployment' }
    ]}
    footerCtaButtonText="Request Free Audit"
    footerCtaDisclaimer='* Contact data is sourced through <strong>Apollo.io</strong>, <strong>LinkedIn Sales Navigator</strong> and other B2B outreach platforms. We don&apos;t own these databases — we provide prospecting & outbound execution as a service.'
    footerFormWebsitePlaceholder="Your website"
    footerFormPhonePlaceholder="Phone"
    footerFormEmailPlaceholder="Email"
    footerFormSuccessTitle="Excellent!"
    footerFormSuccessSubtitle="We'll get back to you within 24h with a full analysis."
    footerFormLoadingText="Sending..."
    footerFormErrorText="Something went wrong. Please try again."
    footerCopyrightText="All rights reserved."
    footerPoweredByText="a service by"
>

    <!-- Hero Section -->
    <Hero
        badge="AlphaGrade — B2B Outbound Intelligence"
        titleLine1='<strong>$250K+</strong> B2B Pipeline'
        titleLine2="in 90 Days. Period."
        subtitle="We identify in-market decision-makers with budget authority. Initiate qualified conversations. Deliver booked meetings with VP+ at $10M+ ARR companies. Apollo.io + full-stack execution, turnkey."
        floatingStats={[
            { value: '+89%', label: 'Reply Rate' },
            { value: '$2.3M', label: 'Pipeline Generated' },
            { value: '14 days', label: 'Time to First Deal' }
        ]}
        formTitle="Request a Free Pipeline Audit"
        formSubtitle="We'll analyze your lead gen potential within 24h"
        formPlaceholder="Your website URL"
        formPhonePlaceholder="Phone"
        formButtonText="Submit"
        formSuccessTitle="Thank you!"
        formSuccessSubtitle="We'll be in touch shortly."
        formLoadingText="Sending..."
        formErrorText="Something went wrong. Please try again or contact us directly."
    />

    <!-- Clients Logo Carousel -->
    <ClientsCarousel />

    <!-- Benefits Section -->
    <BenefitsSection
        title="Why high-growth teams pick AlphaGrade."
        subtitle="We ship what other vendors pitch but never deliver."
        benefits={[
            {
                title: '100% GDPR & CAN-SPAM Compliant',
                description: 'Automated consent tracking. Instant opt-out. Full audit trail. Zero compliance incidents across 3 years of operations.',
                icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
                stat: { icon: '✓', text: '0 incidents' }
            },
            {
                title: '95%+ Inbox Placement — Guaranteed',
                description: 'Professional domain warmup. Pre-send email verification. 24/7 sender reputation monitoring. No spam folder, no wasted spend.',
                icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11L2 12v6a2 2 0 002 2h16a2 2 0 002-2v-6l-3.45-6.89A2 2 0 0016.76 4H7.24a2 2 0 00-1.79 1.11z"/></svg>`,
                stat: { icon: '✓', text: '95%+ inbox' }
            },
            {
                title: 'Fixed Cost Per Lead: $50–$95',
                description: 'You only pay for validated contacts. Live metrics dashboard. No hidden fees. No lock-in. No surprises on the invoice.',
                icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
                stat: { icon: '✓', text: '3-5x ROI' }
            },
            {
                title: 'Live in 24h. Leads in 72h.',
                description: '2-hour ICP workshop. Full stack deployed in 24h. First 50 qualified contacts hitting inboxes by day 3. We move fast.',
                icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
                stat: { icon: '⏱', text: '72h to leads' }
            }
        ]}
    />

    <!-- Tab Group 1: Results + Comparison -->
    <TabSection tabs={['Proven Results', 'Why Your Last Vendor Failed']} id="outreach-proof">
        <div data-tab-panel="0">
            <StatsSection
                title="Battle-Tested Numbers"
                subtitle="Metrics that speak louder than pitch decks"
                stats={[
                    { value: '265', suffix: 'M+', label: 'B2B Contacts', description: 'Verified database' },
                    { value: '98', suffix: '%', label: 'Data Accuracy', description: 'Triple-validated emails' },
                    { value: '100', suffix: '%', label: 'GDPR Compliant', description: 'EU & US regulations' },
                    { value: '72', suffix: 'h', label: 'Time to Launch', description: 'From brief to live outbound' }
                ]}
            />
        </div>
        <div data-tab-panel="1">
            <VendorFailures
                title="Why your last 3 outbound vendors tanked."
                subtitle="And how we make sure we don't repeat the same playbook."
                comparisons={[
                    { problem: 'Garbage data — 40% bounce rate', solution: '98% accuracy, real-time verification, sub-5% bounce guaranteed' },
                    { problem: 'GDPR landmine — $50K+ fines', solution: 'Native compliance, full audit trail, legal review baked in' },
                    { problem: 'Spray-and-pray outreach — 0.5% reply rate', solution: 'AI-powered research + 1:1 personalization, 8-12% reply rate' },
                    { problem: 'Spam factory — domain torched in 3 months', solution: '95% inbox rate, professional warmup, reputation monitoring' },
                    { problem: 'Painful onboarding — 6 weeks to go live', solution: 'Live in 24h, first leads in 72h, or setup is free' },
                    { problem: 'Lock-in contracts — 12 months minimum', solution: 'Month-to-month. Kill switch anytime. Zero penalties.' },
                    { problem: 'Black-box reporting — zero transparency', solution: 'Live dashboard, every metric visible, full API access' },
                    { problem: 'Unclear ROI — "just trust the process"', solution: 'Fixed cost/lead $50-95, pipeline calculator, transparent ROI' }
                ]}
                solutionLabel="ALPHAGRADE:"
            />
        </div>
    </TabSection>

    <!-- Tab Group 2: Advantages + Capabilities -->
    <TabSection tabs={['The AlphaGrade Edge', 'Tech Stack']} id="outreach-tech">
        <div data-tab-panel="0">
            <FeaturesSection
                title='The <span class="brand">AlphaGrade</span> Edge'
                subtitle="AI-powered prospecting that turns outbound into a precision science"
                features={[
                    {
                        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
                        title: 'Predictive Precision Targeting',
                        description: 'Intelligent micro-targeting that continuously refines your TAM down to the perfect ICP slice. Stop burning budget on irrelevant prospects.'
                    },
                    {
                        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/><circle cx="8" cy="14" r="1"/><circle cx="16" cy="14" r="1"/></svg>`,
                        title: 'AI Micro-Segmentation',
                        description: 'Identifies your ideal buyer persona using advanced micro-profiling across Apollo.io, Lemlist, Snov.io, and Instantly.ai — simultaneously.'
                    },
                    {
                        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>`,
                        title: 'Recursive Optimization Engine',
                        description: 'Not a one-shot campaign — a continuous feedback loop: test → analyze → recalibrate → relaunch. Every iteration gets smarter.'
                    },
                    {
                        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
                        title: 'Multi-Layered A/B/C Testing',
                        description: 'Run multiple variants in parallel and let the algorithm surface what converts — in real time. Data-driven, not gut-driven.'
                    },
                    {
                        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
                        title: 'Multichannel Engagement Mapping',
                        description: 'We know exactly where and how each lead prefers to engage: email, LinkedIn, SMS. Right message, right channel, right time.'
                    },
                    {
                        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
                        title: 'Cross-Channel Orchestration',
                        description: 'Synchronized presence across every touchpoint — a cohesive buying experience that maximizes conversion velocity.'
                    },
                    {
                        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>`,
                        title: 'Databox Performance Analytics',
                        description: 'Deep post-campaign analysis: traffic, engagement, conversions. Every insight feeds the next iteration. Full-funnel visibility.'
                    },
                    {
                        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
                        title: 'Business Culture Alignment',
                        description: 'Campaigns adapt not just to your audience, but to the business culture of each target account. Strategic-level personalization.'
                    }
                ]}
            />
        </div>
        <div data-tab-panel="1">
            <CapabilitiesSection
                title="Tech Stack"
                subtitle="Enterprise-grade tooling for predictable, scalable outbound"
            />
        </div>
    </TabSection>

    <!-- Pricing Section -->
    <PricingSection
        title="Packages & Pricing"
        subtitle="Enterprise tools. One-time payment. You own everything."
        note="All tools remain yours. Optional maintenance — pricing negotiable separately."
        tiers={[
            {
                name: 'Starter',
                price: '$3,800',
                priceNote: 'one-time',
                description: 'Full outreach setup with enterprise-grade tooling.',
                featureGroups: [
                    {
                        label: 'Infrastructure',
                        items: [
                            'Dedicated Amazon AWS servers',
                            'Elastic IP via Microsoft Azure',
                            'Google Workspace interface',
                            'Verified B2B contact databases',
                            '100% GDPR & CAN-SPAM compliant'
                        ]
                    },
                    {
                        label: 'Automation',
                        items: [
                            '10+ automated triggers',
                            'Smooth trigger-based sending',
                            'Optimized inbox management',
                            'Email warmup included',
                            'A/B campaign testing'
                        ]
                    },
                    {
                        label: 'Targeting',
                        items: [
                            'Dedicated ICP workshop',
                            'Primary niche targeting',
                            '98%+ email verification'
                        ]
                    }
                ],
                timeline: 'Setup: 24-72h',
                highlighted: false
            },
            {
                name: 'Enterprise',
                price: '$8,200',
                priceNote: 'one-time',
                description: 'Full-stack multichannel outreach with advanced targeting.',
                featureGroups: [
                    {
                        label: 'Infrastructure',
                        items: [
                            'Everything in Starter, plus:',
                            'Multi-server Amazon AWS cluster',
                            'Advanced IP rotation & warmup',
                            'Dedicated inbox pool',
                            'Multiple domains configured'
                        ]
                    },
                    {
                        label: 'Automation',
                        items: [
                            '20+ multichannel triggers',
                            'Email + LinkedIn + SMS synced',
                            'Smooth trigger-based sequencing',
                            'Conditional logic sequences',
                            'Databox analytics dashboard'
                        ]
                    },
                    {
                        label: 'Targeting',
                        items: [
                            'Massive multi-niche databases',
                            'AI micro-segmentation',
                            'Precision targeting — VP+ decision-makers',
                            'Full competitive intelligence study'
                        ]
                    }
                ],
                timeline: 'Setup: 24-72h',
                highlighted: true
            },
            {
                name: 'Custom',
                price: 'Let\'s Talk',
                description: 'Enterprise outreach with bespoke requirements and high volume.',
                featureGroups: [
                    {
                        label: 'Scale',
                        items: [
                            'Unlimited infrastructure',
                            'Custom contact volumes',
                            'Multi-brand / multi-entity'
                        ]
                    },
                    {
                        label: 'Integrations',
                        items: [
                            'CRM integration (HubSpot, Pipedrive)',
                            'Custom API & webhooks',
                            'Advanced workflow automation'
                        ]
                    },
                    {
                        label: 'Support',
                        items: [
                            'Dedicated account manager',
                            'Strategy & execution included',
                            'White-label reporting'
                        ]
                    }
                ],
                timeline: 'Timeline: custom',
                highlighted: false
            }
        ]}
    />

    <!-- CTA Section -->
    <CtaSection
        title="Ready to build your B2B pipeline machine?"
        subtitle="Request a free audit and see how many decision-makers you can reach in your niche."
        buttonText="Request Free Audit"
        note="No strings attached. Full analysis delivered within 24h."
    />

    <!-- Booking Modal -->
    <BookingModal
        title="Book a Demo"
        subtitle="Fill in the form and we'll reach out within 24h"
        websiteLabel="Website"
        websitePlaceholder="https://yourcompany.com"
        phoneLabel="Phone"
        phonePlaceholder="+1 (555) 000-0000"
        emailLabel="Email"
        emailPlaceholder="name@company.com"
        submitText="Submit Request"
        successTitle="Thank you!"
        successSubtitle="We'll be in touch shortly."
        loadingText="Sending..."
        errorText="Something went wrong. Please try again."
    />

</LandingPage>
