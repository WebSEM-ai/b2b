---
import LandingPage from '../layouts/LandingPage.astro';
import HomepageHero from '../components/HomepageHero.astro';
import ClientsCarousel from '../components/ClientsCarousel.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import StatsSection from '../components/StatsSection.astro';
import WhySection from '../components/WhySection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import CtaSection from '../components/CtaSection.astro';
import BookingModal from '../components/BookingModal.astro';

// Page metadata
const pageTitle = "AlphaGrade by WebSEM | Ecosistem B2B Growth";
const pageDescription = "Creștem revenue-ul B2B prin tehnologie și date. Outreach, AI, tracking, raportare și platforme custom — un ecosistem complet de servicii enterprise.";
---

<LandingPage title={pageTitle} description={pageDescription} langSwitch={{ current: 'ro', alternateUrl: '/en' }}>

    <!-- Hero Section -->
    <HomepageHero />

    <!-- Clients Logo Carousel -->
    <ClientsCarousel />

    <!-- Services Grid -->
    <ServicesGrid />

    <!-- Stats / Social Proof -->
    <StatsSection
        title="Cifre din Ecosistem"
        subtitle="Rezultate agregate din toate serviciile AlphaGrade."
        stats={[
            { value: '265', suffix: 'M+', label: 'Contacte B2B', description: 'Bază de date verificată' },
            { value: '98', suffix: '%', label: 'Acuratețe Date', description: 'Emailuri validate' },
            { value: '45', suffix: '+', label: 'Clienți Enterprise', description: 'Companii €1M+ revenue' },
            { value: '72', suffix: 'h', label: 'Time to Launch', description: 'De la brief la execuție' }
        ]}
    />

    <!-- Why AlphaGrade -->
    <WhySection />

    <!-- Process -->
    <ProcessSection
        title="Cum Lucrăm"
        subtitle="De la primul apel la rezultate — în 3 pași simpli."
        steps={[
            { number: 1, title: 'Audit & Discovery', description: 'Analizăm business-ul, piața și obiectivele tale. Identificăm serviciile potrivite din ecosistem.', duration: '1-3 zile' },
            { number: 2, title: 'Strategie & Setup', description: 'Configurăm stack-ul tehnic, definim ICP-ul și pregătim infrastructura pentru execuție.', duration: '3-7 zile' },
            { number: 3, title: 'Execuție & Optimizare', description: 'Lansăm campaniile, monitorizăm KPI-urile și optimizăm continuu pentru rezultate maxime.', duration: 'Ongoing' }
        ]}
    />

    <!-- CTA Section -->
    <CtaSection
        title="Gata să-ți accelerezi creșterea B2B?"
        subtitle="Solicită o consultanță gratuită și descoperă ce servicii din ecosistemul AlphaGrade se potrivesc business-ului tău."
        buttonText="Solicită Consultanță Gratuită"
        note="Fără obligații. Răspuns în 24h."
    />

    <!-- Booking Modal -->
    <BookingModal />

</LandingPage>
