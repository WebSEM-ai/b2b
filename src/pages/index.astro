---
import LandingPage from '../layouts/LandingPage.astro';
import Hero from '../components/Hero.astro';
import ClientsCarousel from '../components/ClientsCarousel.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import StatsSection from '../components/StatsSection.astro';
import VendorFailures from '../components/VendorFailures.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import CapabilitiesSection from '../components/CapabilitiesSection.astro';
import TabSection from '../components/TabSection.astro';
import CaseStudiesSection from '../components/CaseStudiesSection.astro';
import PricingSection from '../components/PricingSection.astro';
import CtaSection from '../components/CtaSection.astro';
import BookingModal from '../components/BookingModal.astro';

// Page metadata
const pageTitle = "WebSEM | B2B Lead Intelligence";
const pageDescription = "Pipeline B2B de €250K+ în 90 de zile. Identificăm decision-makers cu buget. Livrăm meetings cu VP+ din companii €10M+ revenue.";
---

<LandingPage title={pageTitle} description={pageDescription} langSwitch={{ current: 'ro', alternateUrl: '/en' }}>

    <!-- Hero Section -->
    <Hero />

    <!-- Clients Logo Carousel -->
    <ClientsCarousel />

    <!-- Benefits Section - Why companies choose AlphaGrade -->
    <BenefitsSection />

    <!-- Tab Group 1: Rezultate + Comparație -->
    <TabSection tabs={['Rezultate Dovedite', 'De ce au eșuat alții']} id="outreach-proof">
        <div data-tab-panel="0">
            <StatsSection />
        </div>
        <div data-tab-panel="1">
            <VendorFailures />
        </div>
    </TabSection>

    <!-- Tab Group 2: Avantaje + Capabilități -->
    <TabSection tabs={['Avantajele AlphaGrade', 'Capabilități Tehnice']} id="outreach-tech">
        <div data-tab-panel="0">
            <FeaturesSection />
        </div>
        <div data-tab-panel="1">
            <CapabilitiesSection />
        </div>
    </TabSection>

    <!-- Case Studies Section -->
    <CaseStudiesSection />

    <!-- Pricing Section - Outreach Tools -->
    <PricingSection
        title="Pachete & Prețuri"
        subtitle="Tool-uri enterprise. One-time payment."
        note="Toate tool-urile rămân ale tale. Mentenanță opțională — preț negociabil separat."
        tiers={[
            {
                name: 'Starter',
                price: '€3,500',
                priceNote: 'one-time',
                description: 'Setup complet outreach cu tool-uri enterprise.',
                featureGroups: [
                    {
                        label: 'Infrastructură',
                        items: [
                            'Servere dedicate Amazon AWS',
                            'Elastic IP Microsoft Azure',
                            'Interfață Google Suites',
                            'Baze de date B2B verificate',
                            '100% GDPR & compliance'
                        ]
                    },
                    {
                        label: 'Automatizare',
                        items: [
                            '10+ triggere automate',
                            'Trimitere fluidă pe triggere',
                            'Inbox management optimizat',
                            'Email warmup inclus',
                            'A/B testing campanii'
                        ]
                    },
                    {
                        label: 'Targetare',
                        items: [
                            'ICP workshop dedicat',
                            'Targetare pe nișă principală',
                            'Verificare email 98%+'
                        ]
                    }
                ],
                timeline: 'Setup: 24-72h',
                highlighted: false
            },
            {
                name: 'Enterprise',
                price: '€7,500',
                priceNote: 'one-time',
                description: 'Stack complet outreach multichannel cu targetare avansată.',
                featureGroups: [
                    {
                        label: 'Infrastructură',
                        items: [
                            'Tot din Starter, plus:',
                            'Multi-server Amazon AWS',
                            'IP rotation & warm-up avansat',
                            'Inbox pool dedicat',
                            'Domenii multiple configurate'
                        ]
                    },
                    {
                        label: 'Automatizare',
                        items: [
                            '20+ triggere multi-canal',
                            'Email + LinkedIn + SMS sincronizat',
                            'Trimitere fluidă bazată pe triggere',
                            'Sequences cu logică condițională',
                            'Dashboard Databox analytics'
                        ]
                    },
                    {
                        label: 'Targetare',
                        items: [
                            'Baze de date masive multi-nișă',
                            'AI micro-segmentation',
                            'Targetare impecabilă — VP+ decision makers',
                            'Studiu concurență complet'
                        ]
                    }
                ],
                timeline: 'Setup: 24-72h',
                highlighted: true
            },
            {
                name: 'Custom',
                price: 'La cerere',
                description: 'Outreach enterprise cu cerințe specifice și volume mari.',
                featureGroups: [
                    {
                        label: 'Scale',
                        items: [
                            'Infrastructură nelimitată',
                            'Volume custom de contacte',
                            'Multi-brand / multi-entitate'
                        ]
                    },
                    {
                        label: 'Integrări',
                        items: [
                            'CRM integration (HubSpot, Pipedrive)',
                            'API custom & webhooks',
                            'Workflow automation avansat'
                        ]
                    },
                    {
                        label: 'Suport',
                        items: [
                            'Account manager dedicat',
                            'Strategie & execuție inclusă',
                            'Raportare white-label'
                        ]
                    }
                ],
                timeline: 'Timeline: custom',
                highlighted: false
            }
        ]}
    />

    <!-- CTA Section -->
    <CtaSection />

    <!-- Booking Modal -->
    <BookingModal />

</LandingPage>
