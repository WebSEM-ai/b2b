---

<section class="modules-section">
    <div class="modules-container">
        <div class="modules-header">
            <span class="modules-badge">15 Module Integrate</span>
            <h2 class="modules-title">Fiecare modul. <span class="gradient">Fiecare conexiune.</span></h2>
            <p class="modules-subtitle">
                Module specializate care lucrează împreună — datele din fiecare modul alimentează și optimizează pe celelalte.
            </p>
        </div>

        <div class="modules-grid">
            {modules.map((mod) => (
                <div class="module-card" style={`--card-color: ${mod.color}`}>
                    <div class="card-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d={iconPaths[mod.icon]} />
                        </svg>
                    </div>
                    <div class="card-content">
                        <h3 class="card-name">{mod.name}</h3>
                        <p class="card-desc">{mod.desc}</p>
                        <div class="card-synergy">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="synergy-icon">
                                <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3" />
                            </svg>
                            <span>{mod.synergy}</span>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .modules-section {
        padding: 4rem 2rem 6rem;
    }

    .modules-container {
        max-width: 1300px;
        margin: 0 auto;
    }

    .modules-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .modules-badge {
        display: inline-block;
        padding: 0.4rem 1.2rem;
        border-radius: 100px;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        border: 1px solid rgba(99, 102, 241, 0.3);
        background: rgba(99, 102, 241, 0.08);
        color: #a5b4fc;
        margin-bottom: 1.2rem;
    }

    .modules-title {
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        font-weight: 700;
        color: #f1f5f9;
        margin-bottom: 0.8rem;
    }

    .modules-title .gradient {
        background: linear-gradient(135deg, #6366f1, #22d3ee);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .modules-subtitle {
        font-size: 1rem;
        color: #94a3b8;
        max-width: 550px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .modules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.2rem;
    }

    .module-card {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(99, 102, 241, 0.1);
        border-radius: 16px;
        padding: 1.5rem;
        display: flex;
        gap: 1rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(8px);
    }

    .module-card:hover {
        border-color: var(--card-color, rgba(99, 102, 241, 0.3));
        box-shadow: 0 0 30px rgba(99, 102, 241, 0.08);
        transform: translateY(-2px);
    }

    .card-icon {
        flex-shrink: 0;
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: rgba(99, 102, 241, 0.08);
        border: 1px solid rgba(99, 102, 241, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
    }

    .module-card:hover .card-icon {
        background: rgba(99, 102, 241, 0.12);
        border-color: var(--card-color);
    }

    .card-icon svg {
        width: 20px;
        height: 20px;
        color: var(--card-color, #a5b4fc);
    }

    .card-content {
        flex: 1;
        min-width: 0;
    }

    .card-name {
        font-size: 1rem;
        font-weight: 600;
        color: #f1f5f9;
        margin-bottom: 0.4rem;
    }

    .card-desc {
        font-size: 0.82rem;
        color: #94a3b8;
        line-height: 1.55;
        margin-bottom: 0.6rem;
    }

    .card-synergy {
        display: flex;
        align-items: flex-start;
        gap: 0.4rem;
        font-size: 0.72rem;
        color: var(--card-color, #818cf8);
        line-height: 1.4;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(99, 102, 241, 0.08);
    }

    .synergy-icon {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        margin-top: 1px;
    }

    @media (max-width: 640px) {
        .modules-grid {
            grid-template-columns: 1fr;
        }

        .modules-section {
            padding: 3rem 1rem 4rem;
        }
    }
</style>
