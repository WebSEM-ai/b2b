---
const deliverables = [
    'Raport de vizibilitate LLM inițial (benchmark pe 5 AI-uri)',
    'Strategie de conținut optimizată pentru întrebări AI relevante domeniului tău',
    'Implementare on-page și off-page',
    'Raport lunar de monitorizare: apariții, context, competiție',
    'Recomandări acționabile trimestrial'
];
---

<div class="llm-deliverables">
    <div class="llm-deliverables-list">
        {deliverables.map((item, i) => (
            <div class="llm-deliverable-item">
                <div class="llm-deliverable-check">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                </div>
                <div class="llm-deliverable-line"></div>
                <p>{item}</p>
            </div>
        ))}
    </div>
</div>

<script>
    const llmDelObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.llm-deliverable-item').forEach(item => {
        llmDelObserver.observe(item);
    });
</script>

<style>
    .llm-deliverables {
        padding: var(--section-padding);
        max-width: var(--container-max);
        margin: 0 auto;
    }

    .llm-deliverables-list {
        max-width: 700px;
        margin: 0 auto;
        position: relative;
    }

    .llm-deliverable-item {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
        padding: 1.25rem 0;
        position: relative;
        opacity: 0;
        transform: translateX(-20px);
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .llm-deliverable-item.visible {
        opacity: 1;
        transform: translateX(0);
    }

    .llm-deliverable-item:nth-child(2).visible { transition-delay: 0.05s; }
    .llm-deliverable-item:nth-child(3).visible { transition-delay: 0.1s; }
    .llm-deliverable-item:nth-child(4).visible { transition-delay: 0.15s; }
    .llm-deliverable-item:nth-child(5).visible { transition-delay: 0.2s; }

    .llm-deliverable-check {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        background: rgba(139, 92, 246, 0.1);
        border: 2px solid var(--llm-primary, #8B5CF6);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--llm-primary, #8B5CF6);
        z-index: 1;
    }

    .llm-deliverable-check svg {
        width: 16px;
        height: 16px;
    }

    .llm-deliverable-line {
        position: absolute;
        left: 17px;
        top: 48px;
        width: 2px;
        height: calc(100% - 12px);
        background: linear-gradient(to bottom, rgba(139, 92, 246, 0.3), rgba(139, 92, 246, 0.05));
    }

    .llm-deliverable-item:last-child .llm-deliverable-line {
        display: none;
    }

    .llm-deliverable-item p {
        font-size: 0.95rem;
        color: var(--text-secondary);
        line-height: 1.6;
        padding-top: 0.35rem;
    }

    :global([data-theme="light"]) .llm-deliverable-check {
        background: rgba(139, 92, 246, 0.06);
    }

    @media (max-width: 600px) {
        .llm-deliverables-list {
            padding: 0 0.5rem;
        }

        .llm-deliverable-item {
            gap: 1rem;
        }
    }
</style>
