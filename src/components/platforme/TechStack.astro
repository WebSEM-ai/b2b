---
interface TechItem {
    name: string;
    description: string;
    icon: string;
}

interface Props {
    title?: string;
    subtitle?: string;
    technologies?: TechItem[];
}

const {
    title = 'Tehnologii Utilizate',
    subtitle = 'Stack-ul modern din spatele performanței',
    technologies = [
        {
            name: 'Astro',
            description: 'Static Site Generation',
            icon: `<svg viewBox="0 0 256 366" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid"><path fill="currentColor" d="M182.022 9.147c2.982 3.702 4.502 8.44 7.543 17.916L256 246.88c-39.242-19.707-81.78-33.273-126.792-38.519L90.467 48.279a6.2 6.2 0 0 0-5.966-4.56h-.001a6.2 6.2 0 0 0-5.964 4.56l-38.23 160.083C-4.6 213.636-47.026 227.2-86.168 246.88L-19.565 27.063c3.04-9.476 4.56-14.214 7.542-17.916a20 20 0 0 1 7.758-6.22C0.086 0 5.328 0 15.813 0h149.374c10.485 0 15.727 0 20.078 2.927a20 20 0 0 1 7.757 6.22Z" transform="translate(40)"/><path fill="currentColor" d="M189.217 302.926c-7.632 6.588-22.86 11.072-40.478 11.072-22.395 0-41.108-7.354-46.086-17.228-1.772 5.478-2.153 11.746-2.153 15.754 0 0-1.147 18.908 11.998 32.052a15.57 15.57 0 0 1-15.574-15.569c0-16.2 14.247-22.002 28.8-22.002 3.537 0 7.593.504 11.022 2.125 10.264 4.852 21.895 4.076 30.042 1.49 9.237-2.93 18.002-8.592 22.429-7.694Z" opacity=".8" transform="translate(40)"/></svg>`
        },
        {
            name: 'Tailwind CSS',
            description: 'Utility-First Styling',
            icon: `<svg viewBox="0 0 256 154" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid"><path fill="currentColor" d="M128 0Q96 0 80 32q24-32 56-16c10.778 5.389 18.503 13.114 27.262 21.874C175.572 50.182 189.92 64.53 213.333 64.53q32 0 48-32-24 32-56 16c-10.778-5.389-18.503-13.114-27.262-21.874C165.761 14.348 151.414 0 128 0ZM42.667 89.471Q10.667 89.47-5.333 121.47q24-32 56-16c10.778 5.389 18.503 13.114 27.262 21.875 12.31 12.308 26.657 26.656 50.071 26.656q32 0 48-32-24 32-56 16c-10.778-5.39-18.503-13.115-27.262-21.875-12.31-12.309-26.657-26.656-50.071-26.656Z"/></svg>`
        },
        {
            name: 'GSAP',
            description: 'Animații Premium',
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>`
        },
        {
            name: 'Claude AI',
            description: 'AI-Assisted Development',
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm0 3a3 3 0 0 1 3 3c0 1.5-1 2.5-2 3.5S12 13 12 14m0 3.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/></svg>`
        },
        {
            name: 'Vercel',
            description: 'Edge Deployment',
            icon: `<svg viewBox="0 0 256 222" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid"><path fill="currentColor" d="m128 0 128 221.705H0z"/></svg>`
        }
    ]
} = Astro.props;
---

<section class="tech-stack">
    <div class="tech-stack-container">
        <div class="tech-stack-header">
            <h2 class="tech-stack-title">{title}</h2>
            <p class="tech-stack-subtitle">{subtitle}</p>
        </div>
        <div class="tech-stack-grid">
            {technologies.map((tech) => (
                <div class="tech-card">
                    <div class="tech-card-icon" set:html={tech.icon} />
                    <h3 class="tech-card-name">{tech.name}</h3>
                    <p class="tech-card-desc">{tech.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .tech-stack {
        padding: var(--section-padding);
    }

    .tech-stack-container {
        max-width: var(--container-max);
        margin: 0 auto;
    }

    .tech-stack-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .tech-stack-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
    }

    .tech-stack-subtitle {
        font-size: 1.05rem;
        color: var(--text-tertiary);
    }

    .tech-stack-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1.5rem;
    }

    .tech-card {
        background: var(--bg-card);
        border: 1px solid var(--border-light);
        border-radius: 16px;
        padding: 2rem 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
    }

    .tech-card:hover {
        border-color: var(--border-medium);
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
    }

    .tech-card-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto 1.25rem;
        color: var(--text-tertiary);
        transition: color 0.3s ease;
    }

    .tech-card-icon :global(svg) {
        width: 100%;
        height: 100%;
    }

    .tech-card:hover .tech-card-icon {
        color: var(--text-primary);
    }

    .tech-card-name {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.4rem;
    }

    .tech-card-desc {
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    @media (max-width: 900px) {
        .tech-stack-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 600px) {
        .tech-stack-grid {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            gap: 1rem;
            padding-bottom: 1rem;
            -webkit-overflow-scrolling: touch;
        }

        .tech-card {
            min-width: 160px;
            scroll-snap-align: start;
            flex-shrink: 0;
        }

        .tech-stack-grid::-webkit-scrollbar {
            height: 4px;
        }

        .tech-stack-grid::-webkit-scrollbar-track {
            background: var(--border-light);
            border-radius: 2px;
        }

        .tech-stack-grid::-webkit-scrollbar-thumb {
            background: var(--border-medium);
            border-radius: 2px;
        }
    }
</style>
