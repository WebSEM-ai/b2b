---
interface Props {
    tabs: string[];
    id: string;
}

const { tabs, id } = Astro.props;
---

<div class="tab-section" data-tab-section={id}>
    <div class="tab-buttons-wrapper">
        <div class="tab-buttons">
            {tabs.map((tab, i) => (
                <button
                    class={`tab-btn ${i === 0 ? 'tab-btn--active' : ''}`}
                    data-tab-index={i}
                    data-tab-group={id}
                >
                    <span class="tab-btn-text">{tab}</span>
                    <span class="tab-btn-indicator"></span>
                </button>
            ))}
        </div>
    </div>
    <div class="tab-panels" data-tab-panels={id}>
        <slot />
    </div>
</div>

<script>
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const group = btn.getAttribute('data-tab-group');
            const index = btn.getAttribute('data-tab-index');
            if (!group || index === null) return;

            // Update buttons
            document.querySelectorAll(`.tab-btn[data-tab-group="${group}"]`).forEach(b => {
                b.classList.remove('tab-btn--active');
            });
            btn.classList.add('tab-btn--active');

            // Update panels
            const panelsContainer = document.querySelector(`[data-tab-panels="${group}"]`);
            if (!panelsContainer) return;

            const panels = panelsContainer.querySelectorAll(':scope > [data-tab-panel]');
            panels.forEach(panel => {
                const el = panel as HTMLElement;
                if (panel.getAttribute('data-tab-panel') === index) {
                    el.style.display = 'block';
                    el.classList.add('tab-panel--active');
                } else {
                    el.style.display = 'none';
                    el.classList.remove('tab-panel--active');
                }
            });
        });
    });

    // Initialize: hide non-first panels
    document.querySelectorAll('.tab-panels').forEach(container => {
        const panels = container.querySelectorAll(':scope > [data-tab-panel]');
        panels.forEach((panel, i) => {
            const el = panel as HTMLElement;
            if (i === 0) {
                el.style.display = 'block';
                el.classList.add('tab-panel--active');
            } else {
                el.style.display = 'none';
            }
        });
    });
</script>

<style>
    .tab-section {
        position: relative;
    }

    .tab-buttons-wrapper {
        display: flex;
        justify-content: center;
        padding: 0 2rem;
        margin-bottom: -1px;
        position: relative;
        z-index: 2;
    }

    .tab-buttons {
        display: inline-flex;
        gap: 0.5rem;
        padding: 0.35rem;
        background: var(--bg-card);
        border: 1px solid var(--border-medium);
        border-radius: 16px;
        box-shadow: var(--shadow-md);
    }

    .tab-btn {
        position: relative;
        padding: 0.85rem 2rem;
        border: 2px solid transparent;
        border-radius: 12px;
        background: transparent;
        color: var(--text-muted);
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        white-space: nowrap;
        letter-spacing: 0.01em;
    }

    .tab-btn:hover:not(.tab-btn--active) {
        color: var(--text-primary);
        background: var(--bg-card-hover);
        border-color: var(--border-light);
    }

    .tab-btn--active {
        background: var(--gradient-primary);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
    }

    .tab-btn--active .tab-btn-indicator {
        position: absolute;
        bottom: -8px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 6px solid transparent;
        border-right: 6px solid transparent;
        border-top: 6px solid #764ba2;
    }

    .tab-btn:not(.tab-btn--active) .tab-btn-indicator {
        display: none;
    }

    .tab-panels {
        position: relative;
    }

    :global(.tab-panel--active) {
        animation: tabFadeIn 0.35s ease-out;
    }

    @keyframes tabFadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 600px) {
        .tab-buttons-wrapper {
            padding: 0 1rem;
        }

        .tab-buttons {
            width: 100%;
            gap: 0.25rem;
            padding: 0.25rem;
        }

        .tab-btn {
            flex: 1;
            padding: 0.75rem 1rem;
            font-size: 0.8rem;
            text-align: center;
        }
    }
</style>
