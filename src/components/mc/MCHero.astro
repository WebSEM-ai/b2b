---
---

<section class="mc-hero" id="hero">
    <div class="mc-hero-bg">
        <div class="mc-grid-lines"></div>
        <div class="mc-orb mc-orb-1"></div>
        <div class="mc-orb mc-orb-2"></div>
        <div class="mc-orb mc-orb-3"></div>
        <canvas id="mc-network-canvas"></canvas>
    </div>

    <div class="mc-hero-content">
        <div class="mc-hero-badge">AUDIT ENTERPRISE</div>
        <h1 class="mc-hero-title">MARKET COMMAND</h1>
        <div class="mc-hero-by">by <strong>WebSEM</strong></div>
        <p class="mc-hero-subtitle">
            Auditul Enterprise care îți arată exact unde ești, exact unde lovești.
        </p>
        <p class="mc-hero-tagline">Date. Direcții. Decizii.</p>
        <button class="mc-hero-cta" data-open-booking>
            <span class="mc-cta-shine"></span>
            Activează Market Command
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
        </button>
    </div>

    <div class="mc-hero-metrics">
        <div class="mc-metric">
            <span class="mc-metric-value" data-target="6">0</span>
            <span class="mc-metric-label">Dimensiuni</span>
        </div>
        <div class="mc-metric">
            <span class="mc-metric-value" data-target="10" data-prefix="5-">0</span>
            <span class="mc-metric-label">Pagini Raport</span>
        </div>
        <div class="mc-metric">
            <span class="mc-metric-value" data-target="90" data-prefix="60-">0</span>
            <span class="mc-metric-label">min Sesiune</span>
        </div>
    </div>
</section>

<script>
    // Canvas particle network - red theme
    const mcCanvas = document.getElementById('mc-network-canvas') as HTMLCanvasElement;
    if (mcCanvas) {
        const ctx = mcCanvas.getContext('2d');

        function resize() {
            mcCanvas.width = window.innerWidth;
            mcCanvas.height = window.innerHeight;
        }
        resize();
        window.addEventListener('resize', resize);

        const particles: Array<{x: number; y: number; vx: number; vy: number}> = [];
        const particleCount = 50;

        for (let i = 0; i < particleCount; i++) {
            particles.push({
                x: Math.random() * mcCanvas.width,
                y: Math.random() * mcCanvas.height,
                vx: (Math.random() - 0.5) * 0.5,
                vy: (Math.random() - 0.5) * 0.5
            });
        }

        function getColors() {
            const isLight = document.documentElement.getAttribute('data-theme') === 'light';
            return {
                particle: isLight ? 'rgba(230, 57, 70, 0.3)' : 'rgba(230, 57, 70, 0.5)',
                lineBase: isLight ? 0.1 : 0.2
            };
        }

        function animate() {
            if (!ctx) return;
            ctx.clearRect(0, 0, mcCanvas.width, mcCanvas.height);
            const colors = getColors();

            particles.forEach((p, i) => {
                p.x += p.vx;
                p.y += p.vy;

                if (p.x < 0 || p.x > mcCanvas.width) p.vx *= -1;
                if (p.y < 0 || p.y > mcCanvas.height) p.vy *= -1;

                ctx.beginPath();
                ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
                ctx.fillStyle = colors.particle;
                ctx.fill();

                particles.slice(i + 1).forEach(p2 => {
                    const dx = p.x - p2.x;
                    const dy = p.y - p2.y;
                    const dist = Math.sqrt(dx * dx + dy * dy);

                    if (dist < 150) {
                        ctx.beginPath();
                        ctx.moveTo(p.x, p.y);
                        ctx.lineTo(p2.x, p2.y);
                        ctx.strokeStyle = `rgba(230, 57, 70, ${colors.lineBase * (1 - dist / 150)})`;
                        ctx.stroke();
                    }
                });
            });

            requestAnimationFrame(animate);
        }
        animate();
    }

    // Counter animation
    const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const target = parseInt(el.dataset.target || '0');
                const prefix = el.dataset.prefix || '';
                let current = 0;
                const duration = 1500;
                const step = target / (duration / 16);

                function count() {
                    current += step;
                    if (current >= target) {
                        el.textContent = prefix + target;
                        return;
                    }
                    el.textContent = prefix + Math.floor(current);
                    requestAnimationFrame(count);
                }
                count();
                counterObserver.unobserve(el);
            }
        });
    }, { threshold: 0.5 });

    document.querySelectorAll('.mc-metric-value').forEach(el => {
        counterObserver.observe(el);
    });
</script>

<style>
    .mc-hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 8rem 2rem 4rem;
        overflow: hidden;
    }

    .mc-hero-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    .mc-grid-lines {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(230, 57, 70, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(230, 57, 70, 0.03) 1px, transparent 1px);
        background-size: 60px 60px;
        animation: gridMove 20s linear infinite;
    }

    .mc-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: var(--orb-opacity, 0.5);
    }

    .mc-orb-1 {
        width: 400px;
        height: 400px;
        background: rgba(230, 57, 70, 0.15);
        top: -100px;
        right: -100px;
        animation: float 8s ease-in-out infinite;
    }

    .mc-orb-2 {
        width: 300px;
        height: 300px;
        background: rgba(212, 168, 67, 0.1);
        bottom: -50px;
        left: -50px;
        animation: float 10s ease-in-out infinite reverse;
    }

    .mc-orb-3 {
        width: 200px;
        height: 200px;
        background: rgba(230, 57, 70, 0.1);
        top: 40%;
        left: 30%;
        animation: float 12s ease-in-out infinite;
    }

    #mc-network-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .mc-hero-content {
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 800px;
    }

    .mc-hero-badge {
        display: inline-block;
        font-family: 'Orbitron', sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        color: var(--mc-red);
        border: 1px solid rgba(230, 57, 70, 0.3);
        padding: 0.5rem 1.5rem;
        border-radius: 30px;
        margin-bottom: 1.5rem;
        background: rgba(230, 57, 70, 0.05);
    }

    .mc-hero-title {
        font-family: 'Orbitron', sans-serif;
        font-size: clamp(2.5rem, 7vw, 4.5rem);
        font-weight: 700;
        letter-spacing: 0.05em;
        line-height: 1.1;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, var(--mc-red), #ff6b6b, var(--mc-red));
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: mcGradientShift 4s ease infinite;
        text-shadow: none;
    }

    @keyframes mcGradientShift {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
    }

    .mc-hero-by {
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        letter-spacing: 0.05em;
    }

    .mc-hero-by strong {
        color: var(--text-secondary);
    }

    .mc-hero-subtitle {
        font-size: 1.15rem;
        color: var(--text-secondary);
        line-height: 1.7;
        margin-bottom: 1rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .mc-hero-tagline {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--mc-red);
        letter-spacing: 0.1em;
        margin-bottom: 2.5rem;
    }

    .mc-hero-cta {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 2.5rem;
        background: var(--mc-red);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        overflow: hidden;
    }

    .mc-hero-cta svg {
        width: 18px;
        height: 18px;
        transition: transform 0.3s ease;
    }

    .mc-hero-cta:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 40px var(--mc-red-glow);
    }

    .mc-hero-cta:hover svg {
        transform: translateX(4px);
    }

    .mc-cta-shine {
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        transition: left 0.5s ease;
    }

    .mc-hero-cta:hover .mc-cta-shine {
        left: 100%;
    }

    .mc-hero-metrics {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 3rem;
        margin-top: 4rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .mc-metric {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        padding: 1.25rem 2rem;
        background: var(--bg-card);
        border: 1px solid var(--border-light);
        border-radius: 16px;
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }

    .mc-metric:hover {
        border-color: rgba(230, 57, 70, 0.3);
        box-shadow: 0 0 20px var(--mc-red-glow);
    }

    .mc-metric-value {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--mc-red);
    }

    .mc-metric-label {
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    :global([data-theme="light"]) .mc-hero-badge {
        background: rgba(230, 57, 70, 0.08);
    }

    :global([data-theme="light"]) .mc-grid-lines {
        background-image:
            linear-gradient(rgba(230, 57, 70, 0.05) 1px, transparent 1px),
            linear-gradient(90deg, rgba(230, 57, 70, 0.05) 1px, transparent 1px);
    }

    :global([data-theme="light"]) .mc-metric {
        background: rgba(255, 255, 255, 0.8);
        border-color: rgba(0, 0, 0, 0.08);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    @media (max-width: 900px) {
        .mc-hero {
            padding: 7rem 1.5rem 3rem;
            min-height: auto;
        }

        .mc-hero-metrics {
            gap: 1rem;
        }

        .mc-metric {
            padding: 1rem 1.5rem;
        }

        .mc-metric-value {
            font-size: 1.4rem;
        }
    }

    @media (max-width: 480px) {
        .mc-hero-cta {
            padding: 0.9rem 1.8rem;
            font-size: 0.9rem;
        }
    }
</style>
