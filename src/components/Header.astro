---
interface NavChild {
    text: string;
    href: string;
    children?: Array<{ text: string; href: string }>;
}

interface NavLink {
    text: string;
    href: string;
    children?: NavChild[];
}

interface Props {
    links?: NavLink[];
    ctaText?: string;
    tagline?: string;
    langSwitch?: {
        current: 'ro' | 'en';
        alternateUrl: string;
    };
}

const {
    links = [
        { text: 'Servicii', href: '#', children: [
            { text: 'Outreach', href: '/outreach', children: [
                { text: 'Sales Intelligence', href: '/outreach#sales-system' }
            ]},
            { text: 'Market Command', href: '/market-command', children: [
                { text: 'Brand Strategy Audit', href: '/showcase/brand-strategy-audit.html' }
            ]},
            { text: 'Niche Domination', href: '/niche-domination/pharma', children: [
                { text: 'Pharma', href: '/niche-domination/pharma' }
            ]},
            { text: 'Platforme', href: '/platforme', children: [
                { text: 'Smart Performance', href: '/platforme/smart-performance' },
                { text: 'E-Commerce Modern', href: '/platforme/e-commerce-modern' },
                { text: 'Enterprise Stack', href: '/platforme/enterprise-stack' }
            ]},
            { text: 'Marketing 360°', href: '/marketing360' },
            { text: 'Chatbot AI', href: '/chatbot-ai' },
            { text: 'Trafic LLM', href: '/trafic-llm' },
            { text: 'Decision Hub', href: '/decision-hub' },
            { text: 'Data Foundation', href: '/data-foundation' }
        ]},
        { text: 'Blog', href: '/blog' },
        { text: 'Contact', href: '#contact' }
    ],
    ctaText = 'Solicită Demo',
    tagline = 'Enterprise Solutions',
    langSwitch
} = Astro.props;
---

<nav id="navbar">
    <div class="nav-container">
        <a href="/" class="logo-link">
            <img src="/websem-logo.png" alt="WebSEM" class="logo-websem" />
            <div class="logo-content">
                <span class="logo-wordmark">WEBSEM</span>
                <span class="logo-tagline">{tagline}</span>
            </div>
        </a>

        <button class="nav-mobile-toggle" id="mobile-toggle" aria-label="Toggle menu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="nav-links" id="nav-links">
            {links.map(link => (
                link.children ? (
                    <div class="nav-dropdown">
                        <a href={link.href} class="nav-link nav-link--dropdown">
                            {link.text}
                            <svg class="nav-dropdown-arrow" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </a>
                        <div class="nav-dropdown-menu">
                            {link.children.map(child => (
                                child.children ? (
                                    <div class="nav-dropdown-group">
                                        <a href={child.href} class="nav-dropdown-item nav-dropdown-item--parent">
                                            {child.text}
                                            <svg class="nav-sub-arrow" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </a>
                                        <div class="nav-dropdown-sub">
                                            {child.children.map(sub => (
                                                <a href={sub.href} class="nav-dropdown-item nav-dropdown-item--sub">{sub.text}</a>
                                            ))}
                                        </div>
                                    </div>
                                ) : (
                                    <a href={child.href} class="nav-dropdown-item">{child.text}</a>
                                )
                            ))}
                        </div>
                    </div>
                ) : (
                    <a href={link.href} class="nav-link">{link.text}</a>
                )
            ))}
            <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
                <!-- Moon icon - shown in light mode -->
                <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                </svg>
                <!-- Sun icon - shown in dark mode -->
                <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
            </button>
            {langSwitch && (
                <a href={langSwitch.alternateUrl} class="lang-switch" aria-label={`Switch to ${langSwitch.current === 'ro' ? 'English' : 'Română'}`}>
                    <span class={`lang-option ${langSwitch.current === 'ro' ? 'lang-active' : ''}`}>RO</span>
                    <span class="lang-divider"></span>
                    <span class={`lang-option ${langSwitch.current === 'en' ? 'lang-active' : ''}`}>EN</span>
                </a>
            )}
            <a href="javascript:void(0)" class="nav-cta" id="open-booking-modal">
                <span class="nav-cta-glow"></span>
                {ctaText}
            </a>
        </div>
    </div>
</nav>

<script>
    // Theme toggle functionality
    const themeToggle = document.getElementById('theme-toggle');

    // Get initial theme from localStorage or default to dark
    function getTheme() {
        const stored = localStorage.getItem('theme');
        if (stored) return stored;
        // Check system preference as fallback
        if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            return 'light';
        }
        return 'dark'; // Default to dark
    }

    // Apply theme to document
    function applyTheme(theme: string) {
        if (theme === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
        } else {
            document.documentElement.removeAttribute('data-theme');
        }
        localStorage.setItem('theme', theme);
    }

    // Initialize theme on page load
    applyTheme(getTheme());

    // Toggle theme on button click
    themeToggle?.addEventListener('click', () => {
        const currentTheme = getTheme();
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(newTheme);
    });

    // Scroll effect
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
            navbar?.classList.add('scrolled');
        } else {
            navbar?.classList.remove('scrolled');
        }
    });

    // Mobile menu toggle
    const mobileToggle = document.getElementById('mobile-toggle');
    const navLinks = document.getElementById('nav-links');

    mobileToggle?.addEventListener('click', () => {
        navLinks?.classList.toggle('active');
    });

    // Close mobile menu on link click (except dropdown triggers)
    document.querySelectorAll('.nav-link:not(.nav-link--dropdown)').forEach(link => {
        link.addEventListener('click', () => {
            navLinks?.classList.remove('active');
        });
    });

    // Close mobile menu on dropdown item click (exclude parent items with children)
    document.querySelectorAll('.nav-dropdown-item:not(.nav-dropdown-item--parent)').forEach(link => {
        link.addEventListener('click', () => {
            navLinks?.classList.remove('active');
        });
    });

    // Mobile dropdown toggle (Level 1 - Servicii)
    document.querySelectorAll('.nav-link--dropdown').forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            if (window.innerWidth <= 900) {
                e.preventDefault();
                const dropdown = trigger.closest('.nav-dropdown');
                dropdown?.classList.toggle('active');
                // Close all open sub-groups when toggling Level 1
                dropdown?.querySelectorAll('.nav-dropdown-group.active').forEach(g => {
                    g.classList.remove('active');
                });
            }
        });
    });

    // Mobile dropdown toggle (Level 2 - Niche Domination, Platforme)
    document.querySelectorAll('.nav-dropdown-item--parent').forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            if (window.innerWidth <= 900) {
                e.preventDefault();
                const group = trigger.closest('.nav-dropdown-group');
                // Close sibling groups
                group?.parentElement?.querySelectorAll('.nav-dropdown-group.active').forEach(g => {
                    if (g !== group) g.classList.remove('active');
                });
                group?.classList.toggle('active');
            }
        });
    });

    // Open booking modal
    const openModalBtn = document.getElementById('open-booking-modal');
    openModalBtn?.addEventListener('click', () => {
        const modal = document.getElementById('booking-modal');
        modal?.classList.add('active');
        document.body.classList.add('modal-open');
    });
</script>

<style>
    .logo-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
    }

    .logo-websem {
        width: 44px;
        height: 44px;
        object-fit: contain;
        filter: invert(1);
        opacity: 0.95;
        transition: opacity 0.3s ease;
    }

    .logo-link:hover .logo-websem {
        opacity: 1;
    }

    :global([data-theme="light"]) .logo-websem {
        filter: none;
        opacity: 0.9;
    }

    :global([data-theme="light"]) .logo-link:hover .logo-websem {
        opacity: 1;
    }

    .logo-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
        line-height: 1;
    }

    .logo-wordmark {
        font-family: 'Space Grotesk', 'Inter', sans-serif;
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        color: var(--text-primary);
        line-height: 1;
    }

    .logo-tagline {
        font-family: 'Inter', sans-serif;
        font-size: 0.62rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--text-muted);
        opacity: 0.75;
        line-height: 1;
    }

    /* Language Switch */
    .lang-switch {
        display: flex;
        align-items: center;
        gap: 0;
        background: var(--bg-card);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 0.3rem 0.1rem;
        text-decoration: none;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .lang-switch:hover {
        border-color: var(--border-accent);
        box-shadow: 0 0 12px rgba(99, 102, 241, 0.15);
    }

    .lang-option {
        font-family: 'Inter', sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        color: var(--text-muted);
        transition: all 0.3s ease;
        line-height: 1;
    }

    .lang-option.lang-active {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
    }

    .lang-divider {
        width: 1px;
        height: 14px;
        background: var(--border-light);
    }

    @media (max-width: 900px) {
        .lang-switch {
            order: -1;
            align-self: center;
        }
    }

    .nav-sub-arrow {
        display: none;
        width: 10px;
        height: 10px;
        transition: transform 0.3s ease;
        flex-shrink: 0;
    }

    @media (max-width: 900px) {
        .nav-sub-arrow {
            display: inline-block;
        }
    }

    @media (max-width: 900px) {
        .logo-websem {
            width: 36px;
            height: 36px;
        }

        .logo-wordmark {
            font-size: 0.95rem;
            letter-spacing: 0.12em;
        }

        .logo-tagline {
            font-size: 0.55rem;
            letter-spacing: 0.16em;
        }
    }
</style>
