---
interface Persona {
    name: string;
    tagline: string;
    brand: string;
    industry: string;
    description: string;
    personality: string;
    color: string;
    portrait: string;
    images: string[];
    url: string;
    quotes: string[];
}

interface Props {
    title?: string;
    subtitle?: string;
}

const {
    title = 'Personalități AI care <span class="gradient-text">vând</span>',
    subtitle = 'Nu template-uri generice. Chatboți cu personalitate unică, antrenați pe datele brandului.'
} = Astro.props;

const personas: Persona[] = [
    {
        name: 'Dona',
        tagline: 'Ironică. Inteligentă. Expert în hormoni.',
        brand: 'DonaVital®',
        industry: 'Pharma & Suplimente',
        description: 'Dona nu e un chatbot care te întâmpină cu "Cu ce te pot ajuta?". Dona te provoacă, te corectează cu ironie inteligentă și te trimite exact unde trebuie — la produsul potrivit, la testul hormonal corect.',
        personality: 'Ironie Smart',
        color: '#E91E7B',
        portrait: '/images/blog/chatbot-showcase/dona/dona-portrait.jpg',
        images: [
            '/images/blog/chatbot-showcase/dona/ChatBot-AI-1.png',
            '/images/blog/chatbot-showcase/dona/ChatBot-AI-2.png',
            '/images/blog/chatbot-showcase/dona/ChatBot-AI-3.png',
            '/images/blog/chatbot-showcase/dona/ChatBot-AI-4.png'
        ],
        url: '/blog/chatbot-dona-personalitate-ironica-donavital/',
        quotes: [
            '"Luna nu e manager de resurse umane pentru ovare."',
            '"Nu sunt comedian, sunt expert în hormoni."',
            '"Hormonii dezechilibrați te fac sensibilă, nu eu nesimțită."'
        ]
    },
    {
        name: 'Hanna',
        tagline: 'Echilibrată. Calculată. Consultant tehnic.',
        brand: 'Haier România',
        industry: 'HVAC & Climatizare',
        description: 'Hanna nu ghicește — întreabă. Fiecare conversație e un mini-audit: suprafață, etaje, sistem existent, buget. Abia apoi recomandă. Transformă vizitatori curioși în cereri de ofertă calificate.',
        personality: 'Consultativ',
        color: '#1E3A5F',
        portrait: '/images/blog/chatbot-showcase/hanna/hanna-portrait.jpg',
        images: [
            '/images/blog/chatbot-showcase/hanna/ChatBot-AI-5.png',
            '/images/blog/chatbot-showcase/hanna/ChatBot-AI-6.png',
            '/images/blog/chatbot-showcase/hanna/ChatBot-AI-7.png',
            '/images/blog/chatbot-showcase/hanna/ChatBot-AI-8.png'
        ],
        url: '/blog/chatbot-hanna-consultantul-calculat-haier/',
        quotes: [
            '"600 mp total — e o aplicație serioasă."',
            '"Dimensionarea exactă necesită un calcul termic."',
            '"Ce îți trebuie mai mult — răcire vară sau încălzire iarnă?"'
        ]
    },
    {
        name: 'Sierra',
        tagline: 'Prietenoasă. Aventurieră. Familistă.',
        brand: 'Panama Van',
        industry: 'Autorulote Premium',
        description: 'Sierra nu vinde autorulote — vinde weekenduri la munte, libertate pe roți și dimineți cu cafea în pădure. Știe modelele și prețurile, dar mai ales știe ce întrebări să pună.',
        personality: 'Aventurier',
        color: '#2563EB',
        portrait: '/images/blog/chatbot-showcase/sierra/sierra-portrait.jpg',
        images: [
            '/images/blog/chatbot-showcase/sierra/ChatBot-AI-9.png',
            '/images/blog/chatbot-showcase/sierra/ChatBot-AI-10.png',
            '/images/blog/chatbot-showcase/sierra/ChatBot-AI-11.png',
            '/images/blog/chatbot-showcase/sierra/ChatBot-AI-12.png'
        ],
        url: '/blog/chatbot-sierra-prietena-calatoriilor-panama-van/',
        quotes: [
            '"Ești din categoria celor care înțelege valoarea timpului."',
            '"Nu e improvizație, e ritual."',
            '"Să te trezești la munte, nu la benzinărie."'
        ]
    }
];
---

<section class="showcase-section" id="showcase">
    <div class="showcase-header">
        <span class="showcase-label">Studii de Caz — Personalități AI</span>
        <h2 set:html={title} />
        <p>{subtitle}</p>
    </div>

    <div class="showcase-intro">
        <p>Un chatbot fără personalitate e un FAQ animat. <strong>Un chatbot cu personalitate bine construită diferențiază brandul, crește engagement-ul și vinde.</strong> Iată 3 personalități AI pe care le-am construit — fiecare unică, fiecare adaptată brandului și publicului țintă.</p>
    </div>

    <div class="showcase-grid">
        {personas.map((persona) => (
            <div class="persona-card" style={`--persona-color: ${persona.color}`}>
                <div class="persona-top">
                    <div class="persona-portrait">
                        <img src={persona.portrait} alt={persona.name} loading="lazy" />
                    </div>
                    <div class="persona-header">
                        <div class="persona-name-row">
                            <h3 class="persona-name">{persona.name}</h3>
                            <span class="persona-badge">{persona.personality}</span>
                        </div>
                        <p class="persona-tagline">{persona.tagline}</p>
                        <div class="persona-meta">
                            <span class="persona-brand">{persona.brand}</span>
                            <span class="persona-divider">·</span>
                            <span class="persona-industry">{persona.industry}</span>
                        </div>
                    </div>
                </div>

                <p class="persona-description">{persona.description}</p>

                <div class="persona-quotes">
                    {persona.quotes.map((quote) => (
                        <div class="persona-quote">{quote}</div>
                    ))}
                </div>

                <div class="persona-gallery">
                    <div class="persona-gallery-track">
                        {persona.images.map((img, idx) => (
                            <div class="persona-gallery-slide">
                                <img src={img} alt={`${persona.name} — conversație ${idx + 1}`} loading="lazy" />
                            </div>
                        ))}
                    </div>
                    <div class="persona-gallery-dots">
                        {persona.images.map((_, idx) => (
                            <button class={`gallery-dot ${idx === 0 ? 'active' : ''}`} data-index={idx} aria-label={`Imagine ${idx + 1}`}></button>
                        ))}
                    </div>
                </div>

                <a href={persona.url} class="persona-cta">
                    <span>Citește Studiul de Caz</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        ))}
    </div>
</section>

<script>
    // Gallery carousel for each persona card
    document.querySelectorAll('.persona-card').forEach(card => {
        const track = card.querySelector('.persona-gallery-track') as HTMLElement;
        const dots = card.querySelectorAll('.gallery-dot');
        const slides = card.querySelectorAll('.persona-gallery-slide');

        if (!track || !dots.length || !slides.length) return;

        // Dot click navigation
        dots.forEach(dot => {
            dot.addEventListener('click', () => {
                const idx = Number((dot as HTMLElement).dataset.index);
                const slide = slides[idx] as HTMLElement;
                track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: 'smooth' });
            });
        });

        // Sync dots on scroll
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const idx = Array.from(slides).indexOf(entry.target as Element);
                    dots.forEach((d, i) => d.classList.toggle('active', i === idx));
                }
            });
        }, { root: track, threshold: 0.6 });

        slides.forEach(s => observer.observe(s));
    });

    // Animate cards on scroll
    const showcaseObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.persona-card').forEach(card => {
        showcaseObserver.observe(card);
    });
</script>

<style>
    .showcase-section {
        padding: 5rem 2rem;
        background: var(--bg-primary);
        position: relative;
    }

    .showcase-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .showcase-label {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #10B981;
        background: rgba(16, 185, 129, 0.1);
        padding: 0.35rem 1rem;
        border-radius: 100px;
        margin-bottom: 1rem;
    }

    .showcase-header h2 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
    }

    .showcase-header p {
        color: var(--text-muted);
        font-size: 0.95rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .showcase-intro {
        max-width: 800px;
        margin: 0 auto 3.5rem;
        text-align: center;
    }

    .showcase-intro p {
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.7;
    }

    .showcase-grid {
        display: flex;
        flex-direction: column;
        gap: 3rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .persona-card {
        background: var(--bg-card);
        border: 1px solid var(--border-light);
        border-radius: 24px;
        padding: 2.5rem;
        position: relative;
        overflow: hidden;
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.6s ease, transform 0.6s ease;
    }

    .persona-card.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .persona-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: var(--persona-color);
    }

    .persona-top {
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .persona-portrait {
        flex-shrink: 0;
        width: 100px;
        height: 100px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid var(--persona-color);
        box-shadow: 0 0 20px color-mix(in srgb, var(--persona-color) 25%, transparent);
    }

    .persona-portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%);
    }

    .persona-header {
        flex: 1;
    }

    .persona-name-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .persona-name {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .persona-badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--persona-color);
        background: color-mix(in srgb, var(--persona-color) 10%, transparent);
        padding: 0.25rem 0.75rem;
        border-radius: 100px;
    }

    .persona-tagline {
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--text-secondary);
        margin-bottom: 0.5rem;
    }

    .persona-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .persona-brand {
        font-weight: 600;
        color: var(--persona-color);
    }

    .persona-description {
        font-size: 0.95rem;
        color: var(--text-secondary);
        line-height: 1.7;
        margin-bottom: 1.5rem;
    }

    .persona-quotes {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 2rem;
        padding: 1.25rem;
        background: color-mix(in srgb, var(--persona-color) 5%, var(--bg-secondary));
        border-radius: 16px;
        border-left: 3px solid var(--persona-color);
    }

    .persona-quote {
        font-size: 0.88rem;
        font-style: italic;
        color: var(--text-secondary);
        line-height: 1.5;
    }

    .persona-gallery {
        position: relative;
        margin-bottom: 1.5rem;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--border-light);
    }

    .persona-gallery-track {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

    .persona-gallery-track::-webkit-scrollbar {
        display: none;
    }

    .persona-gallery-slide {
        flex: 0 0 100%;
        scroll-snap-align: start;
    }

    .persona-gallery-slide img {
        width: 100%;
        height: auto;
        display: block;
    }

    .persona-gallery-dots {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem;
        background: var(--bg-card);
    }

    .gallery-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: none;
        background: var(--border-light);
        cursor: pointer;
        padding: 0;
        transition: all 0.3s ease;
    }

    .gallery-dot.active {
        background: var(--persona-color);
        transform: scale(1.3);
    }

    .persona-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--persona-color);
        text-decoration: none;
        padding: 0.75rem 1.5rem;
        border: 1px solid color-mix(in srgb, var(--persona-color) 30%, transparent);
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .persona-cta:hover {
        background: color-mix(in srgb, var(--persona-color) 8%, transparent);
        gap: 0.75rem;
        border-color: color-mix(in srgb, var(--persona-color) 50%, transparent);
    }

    @media (max-width: 768px) {
        .showcase-section {
            padding: 3rem 1rem;
        }

        .persona-card {
            padding: 1.5rem;
            border-radius: 20px;
        }

        .persona-name {
            font-size: 1.4rem;
        }

        .persona-top {
            gap: 1rem;
        }

        .persona-portrait {
            width: 72px;
            height: 72px;
        }

        .persona-name-row {
            flex-wrap: wrap;
        }

        .showcase-header h2 {
            font-size: 1.6rem;
        }
    }
</style>
